# Single source of truth for what Mattermore builds from.
#
# Bumping a tag here is how upstream security fixes are picked up. Each patch
# series in patches/ is applied to a clean checkout of the matching tag, so
# there is never a merge to resolve, only a patch that may need rebasing.

# Mattermost server. Patches in patches/server/.
SERVER_TAG=v12.1.0

# Calls plugin. Patches in patches/calls/.
CALLS_TAG=v1.12.7

# Call transcriber. Patches in patches/transcriber/.
TRANSCRIBER_TAG=master

# Mattermore's own plugin version.
#
# This MUST stay above anything Mattermost ships prepackaged, or a server
# upgrade replaces Mattermore with official Calls. The server only overwrites
# an installed plugin when the prepackaged copy has a strictly higher version
# (server/channels/app/plugin.go, shouldPersistTransitionallyPrepackagedPlugin).
#
# Convention: 1000.<upstream>. Upstream v1.12.5 becomes 1000.12.5.
CALLS_VERSION=1000.12.7

# Agents plugin (mattermost-ai). Patches in patches/agents/.
AGENTS_TAG=v2.9.0

# Mattermore's own Agents plugin version. Same rule as CALLS_VERSION: it MUST stay
# above the version Mattermost ships prepackaged, or a server upgrade replaces
# Mattermore's build with the official one. Convention: 1000.<minor>.<patch>,
# so upstream v2.9.0 becomes 1000.9.0.
AGENTS_VERSION=1000.9.0

# Playbooks plugin (playbooks). Patches in patches/playbooks/.
PLAYBOOKS_TAG=v2.12.2

# Mattermore's own Playbooks plugin version. Same rule as CALLS_VERSION and
# AGENTS_VERSION: it MUST stay above the version Mattermost ships prepackaged
# (v2.12.1 in server v12.1.0), or a server upgrade replaces Mattermore's build
# with the official one. Convention: 1000.<minor>.<patch>, so upstream v2.12.2
# becomes 1000.12.2.
PLAYBOOKS_VERSION=1000.12.2
