---
// Most people arriving at these instructions will hand them to an assistant
// rather than follow them by hand. Make that the easy path instead of an
// afterthought: a clean markdown copy of this page, one click away.
interface Props { slug: string }
const { slug } = Astro.props;
---
<div class="ai-bar">
  <div class="ai-bar-text">
    <strong>Following this with an AI assistant?</strong>
    <span>Hand it this page as plain markdown, or the whole site at once.</span>
  </div>
  <div class="ai-bar-actions">
    <button type="button" class="ai-copy" data-md={`/${slug}.md`} data-label="Copy as Markdown">Copy as Markdown</button>
    <span class="ai-status" role="status" aria-live="polite"></span>
    <a href={`/${slug}.md`}>View .md</a>
    <a href="/llms.txt">llms.txt</a>
  </div>
</div>

<script is:inline>
  document.querySelectorAll('.ai-copy').forEach(function (btn) {
    var status = btn.parentElement.querySelector('.ai-status');
    var busy = false;
    btn.addEventListener('click', async function () {
      // Reading textContent would latch on a second click inside the reset
      // window, so the original label lives in a data attribute.
      if (busy) return;
      busy = true;
      try {
        var res = await fetch(btn.dataset.md);
        await navigator.clipboard.writeText(await res.text());
        btn.textContent = 'Copied';
        if (status) status.textContent = 'Page markdown copied to the clipboard';
      } catch (err) {
        // Clipboard access can be refused, so say so rather than failing silently.
        btn.textContent = 'Copy failed';
        if (status) status.textContent = 'Copy failed, open the .md link instead';
      }
      setTimeout(function () {
        btn.textContent = btn.dataset.label;
        if (status) status.textContent = '';
        busy = false;
      }, 2200);
    });
  });
</script>
