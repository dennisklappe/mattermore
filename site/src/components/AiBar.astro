---
// Most people arriving at these instructions will hand them to an assistant
// rather than follow them by hand. Make that the easy path instead of an
// afterthought: a clean markdown copy of this page, one click away.
interface Props { slug: string }
const { slug } = Astro.props;
---
<div class="ai-bar">
  <div class="ai-bar-text">
    <strong>Following this with an AI assistant?</strong>
    <span>Hand it this page as plain markdown, or the whole site at once.</span>
  </div>
  <div class="ai-bar-actions">
    <button type="button" class="ai-copy" data-md={`/${slug}.md`}>Copy as Markdown</button>
    <a href={`/${slug}.md`}>View .md</a>
    <a href="/llms.txt">llms.txt</a>
  </div>
</div>

<script is:inline>
  document.querySelectorAll('.ai-copy').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var original = btn.textContent;
      try {
        var res = await fetch(btn.dataset.md);
        await navigator.clipboard.writeText(await res.text());
        btn.textContent = 'Copied';
      } catch (err) {
        // Clipboard access can be refused, so say so rather than silently failing.
        btn.textContent = 'Copy failed, open the .md';
      }
      setTimeout(function () { btn.textContent = original; }, 2200);
    });
  });
</script>
