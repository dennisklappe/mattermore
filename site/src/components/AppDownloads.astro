---
import { desktopLinks, OTHER_BUILDS } from '../lib/desktop';

const desktop = await desktopLinks();

const apps = [
  { id: 'windows', label: 'Windows', ...desktop.windows },
  { id: 'macos',   label: 'macOS',   ...desktop.macos },
  { id: 'linux',   label: 'Linux',   ...desktop.linux },
  { id: 'ios',     label: 'iPhone and iPad', href: 'https://apps.apple.com/app/mattermost/id1257222717', note: 'App Store', direct: true },
  { id: 'android', label: 'Android', href: 'https://play.google.com/store/apps/details?id=com.mattermost.rn', note: 'Google Play', direct: true },
];
---
<ul class="app-grid" id="app-grid">
  {apps.map((app) => (
    <li>
      <a href={app.href} data-platform={app.id} target="_blank" rel="noopener noreferrer">
        <span class="app-label">{app.label}</span>
        <span class="app-note">{app.note}</span>
      </a>
    </li>
  ))}
</ul>

<p class="app-more">
  Arm builds, AppImage and tarballs are in the
  <a href={OTHER_BUILDS} target="_blank" rel="noopener noreferrer">release list</a>.
</p>

<script is:inline>
  // Nudge the visitor's own platform to the front. Everything stays visible,
  // because platform sniffing is a hint and gets it wrong often enough.
  (function () {
    var grid = document.getElementById('app-grid');
    if (!grid) return;
    var ua = navigator.userAgent;
    var id = /iPhone|iPad|iPod/.test(ua) ? 'ios'
      : /Android/.test(ua) ? 'android'
      : /Mac OS X/.test(ua) ? 'macos'
      : /Windows/.test(ua) ? 'windows'
      : /Linux/.test(ua) ? 'linux' : null;
    if (!id) return;
    var link = grid.querySelector('[data-platform="' + id + '"]');
    if (!link) return;
    link.classList.add('is-yours');
    var item = link.parentElement;
    item.parentElement.insertBefore(item, item.parentElement.firstChild);
  })();
</script>
