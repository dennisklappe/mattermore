---
import BrandMark from './BrandMark.astro';

interface Props { current?: string }
const { current } = Astro.props;
---
<header class="topbar">
  <div class="shell">
    <a class="brand" href="/"><BrandMark />Mattermore</a>
    <nav aria-label="Main">
      <a href="/#compare">What you get</a>
      <a href="/#how">How it works</a>
      <a href="/docs" aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
      <a href="/#faq">FAQ</a>
    </nav>
    <a class="btn btn-primary btn-sm" href="/install">Install</a>
  </div>
</header>
