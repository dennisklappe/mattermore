---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  faq: { question: string; answer: string }[];
}

const { title, description, slug, faq } = Astro.props;

const siblings = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);

// Structured data is derived from the page's own FAQ section, so the two
// cannot drift apart.
const jsonLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((entry) => ({
          '@type': 'Question',
          name: entry.question,
          acceptedAnswer: { '@type': 'Answer', text: entry.answer },
        })),
      }
    : undefined;
---
<Base title={`${title} | Mattermore`} description={description} ogType="article" jsonLd={jsonLd}>
  <TopBar />

  <main>
    <section class="feature-hero">
      <div class="shell">
        <h1>{title}</h1>
        <p class="sub">{description}</p>
        <div class="cta">
          <a class="btn btn-primary" href="/install">Install Mattermore</a>
          <a class="btn btn-ghost" href="/docs">Read the docs</a>
        </div>
      </div>
    </section>

    <div class="shell">
      <article class="feature-body">
        <slot />
      </article>

      <nav class="feature-more" aria-label="Other features">
        <h2>Everything else Mattermore unlocks</h2>
        <ul>
          {siblings.map((page) => (
            <li>
              {page.id === slug ? (
                <span aria-current="page">{page.data.label}</span>
              ) : (
                <a href={`/${page.id}`}>{page.data.label}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </main>

  <SiteFooter blurb={`This page lives in the <a href="https://github.com/dennisklappe/mattermore/blob/main/site/src/content/features/${slug}.md" target="_blank" rel="noopener noreferrer">repository</a> as markdown. Corrections are welcome as a pull request.`} />
</Base>
