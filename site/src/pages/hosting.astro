---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { FORM_ENDPOINT, FALLBACK_EMAIL } from '../config/balie';

const title = 'Managed Mattermore hosting';
const description =
  'Mattermore on your own subdomain, every feature on, email and TLS handled.';
---
<Base title={`${title} | Mattermore`} description={description} ogType="article">
  <TopBar />

  <main id="main">
    <section class="feature-hero">
      <div class="shell">
        <p class="crumb"><a href="/">Mattermore</a> <span>/</span> Hosting</p>
        <h1>We run it for you</h1>
        <p class="sub">{description}</p>
      </div>
    </section>

    <div class="shell">
      <div class="hosting-layout">
        <div class="hosting-body">
          <div class="note">
            <p><strong>Self-hosting is free and identical.</strong> Same features, no licence key, no paid tier. You are paying here for someone else to run the server. <a href="/selfhost">Do it yourself</a> or <a href="/docs">read the docs</a>.</p>
          </div>

          <h2>What you get</h2>
          <ul>
            <li>Your own server at <strong>yourteam.mattermore.dev</strong>, or your own domain if you prefer</li>
            <li>Every feature on from day one, on every tier. Nothing held back for a higher plan</li>
            <li>Email, TLS and backups configured, so invitations work immediately</li>
            <li>Upgrades handled, including upstream security releases</li>
            <li>Your data stays yours. Ask for an export, or for the whole server</li>
          </ul>
          <p>Transcription runs on the server itself, so call audio never reaches a third party. For comparison, 100 seats of Mattermost Professional is roughly €1,000 a month.</p>

          <h2>Who controls what</h2>
          <p>You get system admin on your own server. Users, teams, permissions, sign-on and every plugin setting are yours, without asking us.</p>
          <p>We keep the machine, database, backups, TLS and upgrades. A few settings that would break the server, the site address and database among them, are pinned by us and show as read-only.</p>
          <p>Want out? We hand over the database and files, or move the server to your infrastructure. No lock-in: it is Mattermost underneath and the software is free.</p>

          <h2>Work beyond the server</h2>
          <p>The fee covers running the server. Anything beyond is quoted separately, but we do it:</p>
          <ul>
            <li>Migrating from Slack, Teams or Mattermost, history intact</li>
            <li>Connecting it to GitHub, Jira or something in-house</li>
            <li>Single sign-on against an identity provider we have not met before</li>
            <li>Custom plugins, bots and automations</li>
            <li>Getting your team onto it without the usual confusion</li>
          </ul>
          <p>Fixed quote before anything starts. No hourly surprises.</p>

          <h2>What it is not</h2>
          <p>A small operation, not a support desk. If you need a response time in writing, Mattermost Professional is the honest answer.</p>

          <div class="request-card" id="request">
            <h2>Request a server</h2>
            <p>No signup, no card. You get a reply from a person.</p>

            <form class="hosting-form" id="hosting-form">
              <div class="field">
                <label for="hf-name">Your name</label>
                <input id="hf-name" name="name" type="text" autocomplete="name" required />
              </div>

              <div class="field">
                <label for="hf-email">Email</label>
                <input id="hf-email" name="email" type="email" autocomplete="email" required />
              </div>

              <div class="field">
                <label for="hf-subdomain">Server address</label>
                <div class="subdomain">
                  <input id="hf-subdomain" name="subdomain" type="text" required
                         placeholder="yourteam" pattern="[a-z0-9][a-z0-9-]{1,30}[a-z0-9]"
                         autocapitalize="none" autocorrect="off" spellcheck="false"
                         aria-describedby="hf-subdomain-hint" />
                  <span class="subdomain-suffix">.mattermore.dev</span>
                </div>
                <p class="hint" id="hf-subdomain-hint">Lowercase letters, numbers and hyphens. Own domain instead? Say so below.</p>
              </div>

              <div class="field">
                <label for="hf-size">Roughly how many people</label>
                <input id="hf-size" name="size" type="text" inputmode="numeric" placeholder="25" />
              </div>

              <div class="field">
                <label for="hf-notes">Anything else</label>
                <textarea id="hf-notes" name="notes" rows="4" placeholder="Migrating from Slack, Teams or an existing Mattermost? Need single sign-on or an integration building? Say so here."></textarea>
              </div>

            <div class="visually-hidden" aria-hidden="true">
              <label for="hf-website">Leave this empty</label>
              <input id="hf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <button class="btn btn-primary" type="submit">Send the request</button>
              <p class="hint" id="hf-status" role="status" aria-live="polite"></p>
            </form>
          </div>
        </div>

        <aside class="hosting-aside">
          <div class="price-card">
            <p class="col-label">Indicative pricing</p>
            <ul class="price-list">
              <li><span>Up to 25 people</span><strong>€49 / month</strong></li>
              <li><span>Up to 200 people</span><strong>€149 / month</strong></li>
            </ul>
            <p class="hint">Everything included on both. Larger teams, ask.</p>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <SiteFooter />

  <script is:inline define:vars={{ FORM_ENDPOINT, FALLBACK_EMAIL }}>
    // Posts to a worker that holds the Balie key. Falls back to composing a
    // mail if that fails, so a backend problem never strands the visitor.
    (function () {
      var form = document.getElementById('hosting-form');
      var status = document.getElementById('hf-status');
      if (!form) return;

      function fields() {
        var f = new FormData(form);
        var sub = (f.get('subdomain') || '').toString().trim().toLowerCase();
        return {
          name: (f.get('name') || '').toString().trim(),
          email: (f.get('email') || '').toString().trim(),
          subdomain: sub,
          server: sub + '.mattermore.dev',
          size: (f.get('size') || '').toString().trim(),
          notes: (f.get('notes') || '').toString().trim(),
          website: (f.get('website') || '').toString(),
        };
      }

      function mailFallback(v) {
        var body = 'Name: ' + v.name + '\nEmail: ' + v.email
          + '\nServer: ' + v.server + '\nPeople: ' + (v.size || 'not said')
          + '\n\n' + v.notes;
        status.textContent = 'Opening your mail app. If nothing happens, write to ' + FALLBACK_EMAIL + '.';
        window.location.href = 'mailto:' + FALLBACK_EMAIL
          + '?subject=' + encodeURIComponent('Mattermore hosting: ' + v.server)
          + '&body=' + encodeURIComponent(body);
      }

      form.addEventListener('submit', async function (ev) {
        ev.preventDefault();
        var v = fields();
        var button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        status.textContent = 'Sending.';

        try {
          var res = await fetch(FORM_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(v),
          });
          var data = await res.json().catch(function () { return {}; });
          if (res.ok && data.ok) {
            form.reset();
            status.textContent = 'Sent. We will reply to ' + v.email + '.';
          } else {
            status.textContent = 'That did not go through, opening your mail app instead.';
            mailFallback(v);
          }
        } catch (err) {
          status.textContent = 'That did not go through, opening your mail app instead.';
          mailFallback(v);
        } finally {
          button.disabled = false;
        }
      });
    })();
  </script>
</Base>
