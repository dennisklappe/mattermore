---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { BALIE_ENDPOINT, BALIE_PUBLIC_KEY, TURNSTILE_SITEKEY, FALLBACK_EMAIL, isBalieConfigured } from '../config/balie';

const title = 'Managed Mattermore hosting';
const description =
  'We run Mattermore for you on your own subdomain, with every feature switched on, email and TLS configured, and upgrades handled.';
---
<Base title={`${title} | Mattermore`} description={description} ogType="article">
  <TopBar />

  <main id="main">
    <section class="feature-hero">
      <div class="shell">
        <p class="crumb"><a href="/">Mattermore</a> <span>/</span> Hosting</p>
        <h1>We run it for you</h1>
        <p class="sub">{description}</p>
      </div>
    </section>

    <div class="shell">
      <div class="hosting-layout">
        <div class="hosting-body">
          <h2>What you get</h2>
          <ul>
            <li>Your own server at <strong>yourteam.mattermore.dev</strong>, or your own domain if you prefer</li>
            <li>Every Mattermore feature on from the first day, on every tier: group calls, video, recording, transcription, single sign-on, guest accounts, no user cap. Nothing is held back for a higher plan</li>
            <li>Email, TLS and backups configured, so invitations and password resets work immediately</li>
            <li>Upgrades handled, including tracking upstream Mattermost security releases</li>
            <li>Your data stays yours. Ask for an export at any time, or ask us to hand the whole server over</li>
          </ul>
          <p>Nothing is reserved for a higher plan. Transcription runs on the server itself, so call audio is never sent to a third party. For comparison, 100 seats of Mattermost Professional runs to roughly €1,000 a month.</p>

          <h2>Who controls what</h2>
          <p>You get a system administrator account on your own server. Users, teams, channels, permissions, guest access, single sign-on and every plugin setting are yours to change, and you never need to ask us.</p>
          <p>We keep the layer underneath: the machine, the database, backups, TLS and upgrades. A small number of settings that would break the server if changed, the site address and the database connection among them, are pinned by us and show as read-only in your System Console.</p>
          <p>If you ever want out, we hand you the database and the files, or move the whole server to your own infrastructure. There is no lock-in to engineer around: it is Mattermost underneath, and the software is free.</p>

          <h2>Work beyond the server</h2>
          <p>The monthly fee covers running the server. Anything beyond that is real work and is quoted separately, but it is work we do:</p>
          <ul>
            <li>Migrating from Slack, Teams or an existing Mattermost, with history intact</li>
            <li>Connecting it to what you already use, from GitHub and Jira to something in-house</li>
            <li>Single sign-on against an identity provider we have not met before</li>
            <li>Custom plugins, bots and automations</li>
            <li>Getting your team onto it without the usual month of confusion</li>
          </ul>
          <p>Tell us what you need and you get a fixed quote before anything starts. No hourly surprises.</p>

          <h2>What it is not</h2>
          <p>This is a small operation, not a support desk. If you need contractual guarantees and a response time in writing, buying Mattermost Professional is the honest answer, and it funds the upstream work this is built on.</p>

          <h2>Self-hosting stays free</h2>
          <p>Everything here is <a href="/docs">documented</a> and the software is AGPL-3.0. Run it yourself and pay nothing. This exists for teams who would rather not.</p>

          <div class="request-card" id="request">
            <h2>Request a server</h2>
            <p>No signup, no card. Tell us what you need and you get a reply from a person.</p>

            <form class="hosting-form" id="hosting-form">
              <div class="field">
                <label for="hf-name">Your name</label>
                <input id="hf-name" name="name" type="text" autocomplete="name" required />
              </div>

              <div class="field">
                <label for="hf-email">Email</label>
                <input id="hf-email" name="email" type="email" autocomplete="email" required />
              </div>

              <div class="field">
                <label for="hf-subdomain">Server address</label>
                <div class="subdomain">
                  <input id="hf-subdomain" name="subdomain" type="text" required
                         placeholder="yourteam" pattern="[a-z0-9][a-z0-9-]{1,30}[a-z0-9]"
                         autocapitalize="none" autocorrect="off" spellcheck="false"
                         aria-describedby="hf-subdomain-hint" />
                  <span class="subdomain-suffix">.mattermore.dev</span>
                </div>
                <p class="hint" id="hf-subdomain-hint">Lowercase letters, numbers and hyphens. This is the address your team will type. Bringing your own domain instead is fine, just say so below.</p>
              </div>

              <div class="field">
                <label for="hf-size">Roughly how many people</label>
                <input id="hf-size" name="size" type="text" inputmode="numeric" placeholder="25" />
              </div>

              <div class="field">
                <label for="hf-notes">Anything else</label>
                <textarea id="hf-notes" name="notes" rows="4" placeholder="Migrating from Slack, Teams or an existing Mattermost? Need single sign-on or an integration building? Say so here."></textarea>
              </div>

              {isBalieConfigured && (
              <div class="cf-turnstile field" data-sitekey={TURNSTILE_SITEKEY} data-callback="balieTurnstileToken"></div>
            )}

            <button class="btn btn-primary" type="submit">Send the request</button>
              <p class="hint" id="hf-status" role="status" aria-live="polite"></p>
            </form>
          </div>
        </div>

        <aside class="hosting-aside">
          <div class="price-card">
            <p class="col-label">Indicative pricing</p>
            <ul class="price-list">
              <li><span>Up to 25 people</span><strong>€49 / month</strong></li>
              <li><span>Up to 200 people</span><strong>€149 / month</strong></li>
            </ul>
            <p class="hint">Everything included on both. Larger teams, ask.</p>
          </div>
        </aside>
      </div>
    </div>
  </main>

  {isBalieConfigured && (
    <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
  )}

  <SiteFooter />

  <script is:inline define:vars={{ BALIE_ENDPOINT, BALIE_PUBLIC_KEY, FALLBACK_EMAIL, isBalieConfigured }}>
    // Posts to Balie when a public key and Turnstile sitekey are configured.
    // Until then it composes a mail, so the page is never broken mid-setup.
    (function () {
      var form = document.getElementById('hosting-form');
      var status = document.getElementById('hf-status');
      if (!form) return;

      var turnstileToken = '';
      window.balieTurnstileToken = function (token) { turnstileToken = token; };

      function fields() {
        var f = new FormData(form);
        var sub = (f.get('subdomain') || '').toString().trim();
        return {
          name: (f.get('name') || '').toString().trim(),
          email: (f.get('email') || '').toString().trim(),
          server: sub + '.mattermore.dev',
          size: (f.get('size') || '').toString().trim(),
          notes: (f.get('notes') || '').toString().trim(),
        };
      }

      function body(v) {
        return [
          'Server: ' + v.server,
          'People: ' + (v.size || 'not said'),
          '',
          v.notes || '(no further detail)',
        ].join('\n');
      }

      function mailFallback(v) {
        var href = 'mailto:' + FALLBACK_EMAIL
          + '?subject=' + encodeURIComponent('Mattermore hosting: ' + v.server)
          + '&body=' + encodeURIComponent('Name: ' + v.name + '\nEmail: ' + v.email + '\n' + body(v));
        status.textContent = 'Opening your mail app. If nothing happens, write to ' + FALLBACK_EMAIL + '.';
        window.location.href = href;
      }

      form.addEventListener('submit', async function (ev) {
        ev.preventDefault();
        var v = fields();

        if (!isBalieConfigured) {
          mailFallback(v);
          return;
        }

        if (!turnstileToken) {
          status.textContent = 'Waiting on the anti-spam check. Try again in a moment.';
          return;
        }

        var button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        status.textContent = 'Sending.';

        try {
          var res = await fetch(BALIE_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + BALIE_PUBLIC_KEY },
            body: JSON.stringify({
              email: v.email,
              name: v.name,
              subject: 'Hosting request: ' + v.server,
              message: body(v),
              form: 'hosting',
              turnstileToken: turnstileToken,
              metadata: { subdomain: v.server, size: v.size },
            }),
          });
          var data = await res.json().catch(function () { return {}; });
          if (res.ok && data.ok) {
            form.reset();
            status.textContent = 'Sent. We will reply to ' + v.email + '.';
          } else {
            // Never strand the visitor on a backend problem.
            status.textContent = 'That did not go through, opening your mail app instead.';
            mailFallback(v);
          }
        } catch (err) {
          status.textContent = 'That did not go through, opening your mail app instead.';
          mailFallback(v);
        } finally {
          button.disabled = false;
          if (window.turnstile) window.turnstile.reset();
          turnstileToken = '';
        }
      });
    })();
  </script>
</Base>
