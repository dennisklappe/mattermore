---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import FeatureLayout from '../layouts/FeatureLayout.astro';
import { extractFaq } from '../lib/faq';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const features = await getCollection('features');

  return [
    ...docs.map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: 'docs' as const } })),
    ...features.map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: 'feature' as const } })),
  ];
}

const { entry, kind } = Astro.props;
const { Content, headings } = await render(entry);
---
{kind === 'docs' ? (
  <DocsLayout
    title={entry.data.title}
    description={entry.data.description}
    slug={entry.id}
    headings={headings}
  >
    <Content />
  </DocsLayout>
) : (
  <FeatureLayout
    title={entry.data.title}
    description={entry.data.description}
    slug={entry.id}
    faq={extractFaq(entry.body ?? '')}
    headings={headings}
  >
    <Content />
  </FeatureLayout>
)}
