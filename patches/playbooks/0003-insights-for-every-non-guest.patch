+func TestPlaybookService_InsightsWithoutLicense(t *testing.T) {
+	setup := func(t *testing.T, user *model.User) (app.PlaybookService, *mock_app.MockPlaybookStore) {
+		t.Helper()
+
+		ctrl := gomock.NewController(t)
+		t.Cleanup(ctrl.Finish)
+
+		mockStore := mock_app.NewMockPlaybookStore(ctrl)
+		mockAPI := &plugintest.API{}
+		mockAPI.On("GetLicense").Return(nil).Maybe()
+		mockAPI.On("GetUser", user.Id).Return(user, nil)
+		t.Cleanup(func() { mockAPI.AssertExpectations(t) })
+
+		service := app.NewPlaybookService(
+			mockStore,
+			mock_bot.NewMockPoster(ctrl),
+			pluginapi.NewClient(mockAPI, nil),
+			nil, // auditor
+			&metrics.Metrics{},
+			mock_app.NewMockPropertyService(ctrl),
+			mock_app.NewMockConditionService(ctrl),
+		)
+
+		return service, mockStore
+	}
+
+	opts := &app.InsightsOpts{}
+	insights := &app.PlaybooksInsightsList{}
+
+	t.Run("a member can read the team's insights", func(t *testing.T) {
+		service, mockStore := setup(t, &model.User{Id: "member-id", Roles: model.SystemUserRoleId})
+		mockStore.EXPECT().GetTopPlaybooksForTeam("team-id", "member-id", opts).Return(insights, nil)
+
+		got, err := service.GetTopPlaybooksForTeam("team-id", "member-id", opts)
+
+		require.NoError(t, err)
+		assert.Same(t, insights, got)
+	})
+
+	t.Run("a member can read their own insights", func(t *testing.T) {
+		service, mockStore := setup(t, &model.User{Id: "member-id", Roles: model.SystemUserRoleId})
+		mockStore.EXPECT().GetTopPlaybooksForUser("team-id", "member-id", opts).Return(insights, nil)
+
+		got, err := service.GetTopPlaybooksForUser("team-id", "member-id", opts)
+
+		require.NoError(t, err)
+		assert.Same(t, insights, got)
+	})
+
+	t.Run("a guest still cannot read insights", func(t *testing.T) {
+		service, _ := setup(t, &model.User{Id: "guest-id", Roles: model.SystemGuestRoleId})
+
+		got, err := service.GetTopPlaybooksForTeam("team-id", "guest-id", opts)
+
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "Guests")
+		assert.Nil(t, got)
+	})
+}
