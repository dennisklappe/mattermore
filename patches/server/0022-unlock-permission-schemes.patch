+
+func TestSchemesWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	require.NoError(t, th.App.SetPhase2PermissionsMigrationStatus(true))
+	th.App.Srv().SetLicense(nil)
+	require.Nil(t, th.App.Srv().License())
+
+	ctx := context.Background()
+
+	teamScheme, resp, err := th.SystemAdminClient.CreateScheme(ctx, &model.Scheme{
+		DisplayName: model.NewId(),
+		Name:        model.NewId(),
+		Description: model.NewId(),
+		Scope:       model.SchemeScopeTeam,
+	})
+	require.NoError(t, err)
+	CheckCreatedStatus(t, resp)
+
+	channelScheme, resp, err := th.SystemAdminClient.CreateScheme(ctx, &model.Scheme{
+		DisplayName: model.NewId(),
+		Name:        model.NewId(),
+		Description: model.NewId(),
+		Scope:       model.SchemeScopeChannel,
+	})
+	require.NoError(t, err)
+	CheckCreatedStatus(t, resp)
+
+	renamed := "renamed"
+	patched, resp, err := th.SystemAdminClient.PatchScheme(ctx, teamScheme.Id, &model.SchemePatch{DisplayName: &renamed})
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+	require.Equal(t, renamed, patched.DisplayName)
+
+	resp, err = th.SystemAdminClient.UpdateTeamScheme(ctx, th.BasicTeam.Id, teamScheme.Id)
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+	team, _, err := th.SystemAdminClient.GetTeam(ctx, th.BasicTeam.Id, "")
+	require.NoError(t, err)
+	require.NotNil(t, team.SchemeId)
+	require.Equal(t, teamScheme.Id, *team.SchemeId)
+
+	resp, err = th.SystemAdminClient.UpdateChannelScheme(ctx, th.BasicChannel.Id, channelScheme.Id)
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+	channel, _, err := th.SystemAdminClient.GetChannel(ctx, th.BasicChannel.Id)
+	require.NoError(t, err)
+	require.NotNil(t, channel.SchemeId)
+	require.Equal(t, channelScheme.Id, *channel.SchemeId)
+
+	t.Run("permissions still apply without a license", func(t *testing.T) {
+		_, resp, err := th.Client.CreateScheme(ctx, &model.Scheme{
+			DisplayName: model.NewId(),
+			Name:        model.NewId(),
+			Description: model.NewId(),
+			Scope:       model.SchemeScopeTeam,
+		})
+		require.Error(t, err)
+		CheckForbiddenStatus(t, resp)
+
+		resp, err = th.Client.UpdateTeamScheme(ctx, th.BasicTeam.Id, teamScheme.Id)
+		require.Error(t, err)
+		CheckForbiddenStatus(t, resp)
+	})
+
+	resp, err = th.SystemAdminClient.DeleteScheme(ctx, channelScheme.Id)
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+	resp, err = th.SystemAdminClient.DeleteScheme(ctx, teamScheme.Id)
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+}
