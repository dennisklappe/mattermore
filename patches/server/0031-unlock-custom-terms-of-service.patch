+	t.Parallel()
+
+	for name, enabled := range map[string]bool{"enabled": true, "disabled": false} {
+		t.Run(name, func(t *testing.T) {
+			cfg := &model.Config{}
+			cfg.SetDefaults()
+			*cfg.SupportSettings.CustomTermsOfServiceEnabled = enabled
+			*cfg.SupportSettings.CustomTermsOfServiceReAcceptancePeriod = 30
