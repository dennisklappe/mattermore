+			props := GenerateClientConfig(cfg, "", nil)
+			assert.Equal(t, fmt.Sprintf("%t", enabled), props["EnableCustomTermsOfService"])
+			assert.Equal(t, "30", props["CustomTermsOfServiceReAcceptancePeriod"])
+		})
+	}
+}
