diff --git a/webapp/channels/src/components/admin_console/admin_definition_custom_terms_of_service.test.tsx b/webapp/channels/src/components/admin_console/admin_definition_custom_terms_of_service.test.tsx
new file mode 100644
index 00000000..32613aab
--- /dev/null
+++ b/webapp/channels/src/components/admin_console/admin_definition_custom_terms_of_service.test.tsx
@@ -0,0 +1,54 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {AdminConfig, ClientLicense} from '@mattermost/types/config';
+
+import {RESOURCE_KEYS} from 'mattermost-redux/constants/permissions_sysconsole';
+
+import {LicenseSkus} from 'utils/constants';
+
+import AdminDefinition from './admin_definition';
+import type {AdminDefinitionSubSection, Check, ConsoleAccess} from './types';
+
+const config = {} as Partial<AdminConfig>;
+
+const canRead = {
+    read: {[RESOURCE_KEYS.COMPLIANCE.CUSTOM_TERMS_OF_SERVICE]: true},
+    write: {[RESOURCE_KEYS.COMPLIANCE.CUSTOM_TERMS_OF_SERVICE]: true},
+} as ConsoleAccess;
+
+const cannotRead = {
+    read: {[RESOURCE_KEYS.COMPLIANCE.CUSTOM_TERMS_OF_SERVICE]: false},
+    write: {[RESOURCE_KEYS.COMPLIANCE.CUSTOM_TERMS_OF_SERVICE]: false},
+} as ConsoleAccess;
+
+const licenses: Record<string, ClientLicense> = {
+    'no license': {IsLicensed: 'false'} as ClientLicense,
+    'an empty license record': {} as ClientLicense,
+    Professional: {IsLicensed: 'true', SkuShortName: LicenseSkus.Professional, CustomTermsOfService: 'false'} as ClientLicense,
+};
+
+const subsections = AdminDefinition.compliance.subsections as Record<string, AdminDefinitionSubSection>;
+
+function isHidden(subsection: AdminDefinitionSubSection, license: ClientLicense, access: ConsoleAccess) {
+    const check = subsection.isHidden as Extract<Check, (...args: any[]) => boolean>;
+    return check(config, {}, license, true, access);
+}
+
+describe('AdminDefinition - Custom Terms of Service', () => {
+    test('has no feature discovery (upsell) page', () => {
+        expect('custom_terms_of_service_feature_discovery' in subsections).toBe(false);
+    });
+
+    test('is not marked as a restricted feature', () => {
+        expect(subsections.custom_terms_of_service.restrictedIndicator).toBeUndefined();
+    });
+
+    test.each(Object.keys(licenses))('is visible with %s', (name) => {
+        expect(isHidden(subsections.custom_terms_of_service, licenses[name], canRead)).toBe(false);
+    });
+
+    test('is hidden from admins without read access', () => {
+        expect(isHidden(subsections.custom_terms_of_service, licenses['no license'], cannotRead)).toBe(true);
+    });
+});
