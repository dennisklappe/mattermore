+func TestCPAWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	th.App.Srv().SetLicense(nil)
+	require.Nil(t, th.App.Srv().License())
+
+	ctx := context.Background()
+
+	field, resp, err := th.SystemAdminClient.CreateCPAField(ctx, &model.PropertyField{Name: celSafeName(), Type: model.PropertyFieldTypeText})
+	require.NoError(t, err)
+	CheckCreatedStatus(t, resp)
+
+	fields, resp, err := th.Client.ListCPAFields(ctx)
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+	ids := make([]string, 0, len(fields))
+	for _, f := range fields {
+		ids = append(ids, f.ID)
+	}
+	require.Contains(t, ids, field.ID)
+
+	renamed := celSafeName()
+	patched, resp, err := th.SystemAdminClient.PatchCPAField(ctx, field.ID, &model.PropertyFieldPatch{Name: &renamed})
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+	require.Equal(t, renamed, patched.Name)
+
+	values := map[string]json.RawMessage{field.ID: json.RawMessage(`"Field Value"`)}
+	patchedValues, resp, err := th.Client.PatchCPAValues(ctx, values)
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+	require.NotEmpty(t, patchedValues)
+
+	listed, resp, err := th.Client.ListCPAValues(ctx, th.BasicUser.Id)
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+	require.NotEmpty(t, listed)
+
+	t.Run("permissions still apply without a license", func(t *testing.T) {
+		_, resp, err := th.Client.CreateCPAField(ctx, &model.PropertyField{Name: celSafeName(), Type: model.PropertyFieldTypeText})
+		require.Error(t, err)
+		CheckForbiddenStatus(t, resp)
+	})
+
+	resp, err = th.SystemAdminClient.DeleteCPAField(ctx, field.ID)
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+}
