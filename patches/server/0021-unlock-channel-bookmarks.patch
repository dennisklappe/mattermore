+func TestChannelBookmarksWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	require.NoError(t, th.App.SetPhase2PermissionsMigrationStatus(true))
+	th.App.Srv().SetLicense(nil)
+	require.Nil(t, th.App.Srv().License())
+
+	ctx := context.Background()
+	newBookmark := func(name string) *model.ChannelBookmark {
+		return &model.ChannelBookmark{
+			ChannelId:   th.BasicChannel.Id,
+			DisplayName: name,
+			LinkUrl:     "https://example.com",
+			Type:        model.ChannelBookmarkLink,
+		}
+	}
+
+	first, resp, err := th.Client.CreateChannelBookmark(ctx, newBookmark("first"))
+	require.NoError(t, err)
+	CheckCreatedStatus(t, resp)
+	require.Equal(t, "first", first.DisplayName)
+
+	second, _, err := th.Client.CreateChannelBookmark(ctx, newBookmark("second"))
+	require.NoError(t, err)
+
+	renamed := "renamed"
+	updated, resp, err := th.Client.UpdateChannelBookmark(ctx, th.BasicChannel.Id, first.Id, &model.ChannelBookmarkPatch{DisplayName: &renamed})
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+	require.Equal(t, renamed, updated.Updated.DisplayName)
+
+	reordered, resp, err := th.Client.UpdateChannelBookmarkSortOrder(ctx, th.BasicChannel.Id, second.Id, 0)
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+	require.Len(t, reordered, 2)
+	require.Equal(t, second.Id, reordered[0].Id)
+
+	listed, resp, err := th.Client.ListChannelBookmarksForChannel(ctx, th.BasicChannel.Id, 0)
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+	require.Len(t, listed, 2)
+
+	_, resp, err = th.Client.DeleteChannelBookmark(ctx, th.BasicChannel.Id, first.Id)
+	require.NoError(t, err)
+	CheckOKStatus(t, resp)
+
+	listed, _, err = th.Client.ListChannelBookmarksForChannel(ctx, th.BasicChannel.Id, 0)
+	require.NoError(t, err)
+	require.Len(t, listed, 1)
+	require.Equal(t, second.Id, listed[0].Id)
+
+	t.Run("permissions still apply without a license", func(t *testing.T) {
+		th.RemovePermissionFromRole(t, model.PermissionAddBookmarkPublicChannel.Id, model.ChannelUserRoleId)
+		defer th.AddPermissionToRole(t, model.PermissionAddBookmarkPublicChannel.Id, model.ChannelUserRoleId)
+
+		_, resp, err := th.Client.CreateChannelBookmark(ctx, newBookmark("denied"))
+		require.Error(t, err)
+		CheckForbiddenStatus(t, resp)
+	})
+}
