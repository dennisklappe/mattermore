+// startFakeSMTPServer accepts every message and keeps its raw text, so a test can see what would have
+// been mailed. It returns the port and a function that lists the messages received so far.
+func startFakeSMTPServer(t *testing.T) (string, func() []string) {
+	t.Helper()
+
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { ln.Close() })
+
+	var mu sync.Mutex
+	var messages []string
+
+	serve := func(conn net.Conn) {
+		defer conn.Close()
+
+		r := bufio.NewReader(conn)
+		reply := func(line string) { _, _ = conn.Write([]byte(line + "\r\n")) }
+		reply("220 localhost ready")
+
+		for {
+			line, err := r.ReadString('\n')
+			if err != nil {
+				return
+			}
+
+			command := strings.ToUpper(strings.TrimSpace(line))
+			switch {
+			case strings.HasPrefix(command, "DATA"):
+				reply("354 go ahead")
+
+				var body strings.Builder
+				for {
+					l, err := r.ReadString('\n')
+					if err != nil {
+						return
+					}
+					if l == ".\r\n" {
+						break
+					}
+					body.WriteString(l)
+				}
+
+				mu.Lock()
+				messages = append(messages, body.String())
+				mu.Unlock()
+				reply("250 queued")
+			case strings.HasPrefix(command, "QUIT"):
+				reply("221 bye")
+				return
+			default:
+				reply("250 ok")
+			}
+		}
+	}
+
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go serve(conn)
+		}
+	}()
+
+	_, port, err := net.SplitHostPort(ln.Addr().String())
+	require.NoError(t, err)
+
+	return port, func() []string {
+		mu.Lock()
+		defer mu.Unlock()
+		return append([]string(nil), messages...)
+	}
+}
+
+// readableMail returns the text of every part of a raw message, with transfer encodings undone.
+func readableMail(t *testing.T, raw string) string {
+	t.Helper()
+
+	msg, err := netmail.ReadMessage(strings.NewReader(raw))
+	require.NoError(t, err)
+
+	var out strings.Builder
+	var walk func(body io.Reader, encoding, contentType string)
+	walk = func(body io.Reader, encoding, contentType string) {
+		mediaType, params, err := mime.ParseMediaType(contentType)
+		if err == nil && strings.HasPrefix(mediaType, "multipart/") {
+			parts := multipart.NewReader(body, params["boundary"])
+			for {
+				part, err := parts.NextPart()
+				if err != nil {
+					return
+				}
+				walk(part, part.Header.Get("Content-Transfer-Encoding"), part.Header.Get("Content-Type"))
+			}
+		}
+
+		if err == nil && !strings.HasPrefix(mediaType, "text/") {
+			return // attachments such as the sender's avatar are not part of what the recipient reads
+		}
+
+		reader := body
+		switch strings.ToLower(encoding) {
+		case "quoted-printable":
+			reader = quotedprintable.NewReader(body)
+		case "base64":
+			reader = base64.NewDecoder(base64.StdEncoding, body)
+		}
+
+		b, _ := io.ReadAll(reader)
+		out.Write(b)
+	}
+	walk(msg.Body, msg.Header.Get("Content-Transfer-Encoding"), msg.Header.Get("Content-Type"))
+
+	return out.String()
+}
