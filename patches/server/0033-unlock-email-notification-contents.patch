+func TestSendBatchedEmailNotificationContentsWithoutLicense(t *testing.T) {
+	th := Setup(t).InitBasic(t)
+
+	// The test helper installs a license that has every feature; the point here is that none is needed.
+	th.service.license = func() *model.License { return nil }
+
+	port, sentMessages := startFakeSMTPServer(t)
+	th.UpdateConfig(t, func(cfg *model.Config) {
+		*cfg.EmailSettings.SMTPServer = "127.0.0.1"
+		*cfg.EmailSettings.SMTPPort = port
+		*cfg.EmailSettings.ConnectionSecurity = ""
+		*cfg.EmailSettings.EnableSMTPAuth = false
+		*cfg.EmailSettings.SkipServerCertificateVerification = true
+		*cfg.ServiceSettings.SiteURL = "http://testserver"
+	})
+
+	const secret = "zqxsecretmessage"
+
+	// send mails one batched notification under the given contents setting and reports what came out.
+	send := func(t *testing.T, contents string) (recorded int32, text string) {
+		t.Helper()
+
+		th.UpdateConfig(t, func(cfg *model.Config) {
+			*cfg.EmailSettings.EmailNotificationContentsType = contents
+		})
+
+		var deliveries int32
+		th.service.postDeliveryRecorder = func(string, *model.Post) { atomic.AddInt32(&deliveries, 1) }
+
+		before := len(sentMessages())
+		post := &model.Post{Id: model.NewId(), UserId: th.BasicUser.Id, ChannelId: th.BasicChannel.Id, Message: secret}
+		th.service.sendBatchedEmailNotification(th.BasicUser2.Id, []*batchedNotification{{userID: th.BasicUser2.Id, post: post, teamName: th.BasicTeam.Name}})
+
+		sent := sentMessages()
+		require.Len(t, sent, before+1, "the digest should have been mailed")
+
+		return atomic.LoadInt32(&deliveries), readableMail(t, sent[len(sent)-1])
+	}
+
+	t.Run("full contents carry the message and record the delivery", func(t *testing.T) {
+		recorded, text := send(t, model.EmailNotificationContentsFull)
+
+		require.Contains(t, text, secret)
+		require.EqualValues(t, 1, recorded)
+	})
+
+	t.Run("generic contents leave the message out and record nothing", func(t *testing.T) {
+		recorded, text := send(t, model.EmailNotificationContentsGeneric)
+
+		require.NotContains(t, text, secret)
+		require.EqualValues(t, 0, recorded)
+	})
+}
