+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {AdminConfig, ClientLicense} from '@mattermost/types/config';
+
+import {RESOURCE_KEYS} from 'mattermost-redux/constants/permissions_sysconsole';
+
+import {LicenseSkus} from 'utils/constants';
+
+import AdminDefinition from './admin_definition';
+import type {ConsoleAccess} from './types';
+
+const config = {} as Partial<AdminConfig>;
+
+const canWrite = {
+    read: {[RESOURCE_KEYS.SITE.NOTIFICATIONS]: true},
+    write: {[RESOURCE_KEYS.SITE.NOTIFICATIONS]: true},
+} as ConsoleAccess;
+
+const readOnly = {
+    read: {[RESOURCE_KEYS.SITE.NOTIFICATIONS]: true},
+    write: {[RESOURCE_KEYS.SITE.NOTIFICATIONS]: false},
+} as ConsoleAccess;
+
+const licenses: Record<string, ClientLicense> = {
+    'no license': {IsLicensed: 'false'} as ClientLicense,
+    'an empty license record': {} as ClientLicense,
+    Professional: {IsLicensed: 'true', SkuShortName: LicenseSkus.Professional, EmailNotificationContents: 'false'} as ClientLicense,
+};
+
+const KEY = 'EmailSettings.EmailNotificationContentsType';
+
+function findSetting() {
+    const sections = Object.values(AdminDefinition) as any[];
+    for (const section of sections) {
+        for (const subsection of Object.values(section.subsections ?? {}) as any[]) {
+            const found = (subsection.schema?.settings ?? []).find((setting: any) => setting.key === KEY);
+            if (found) {
+                return found;
+            }
+        }
+    }
+    return undefined;
+}
+
+function evaluate(check: unknown, license: ClientLicense, access: ConsoleAccess) {
+    if (typeof check === 'function') {
+        return check(config, {}, license, true, access);
+    }
+    return Boolean(check);
+}
+
+describe('AdminDefinition - Email Notification Contents setting', () => {
+    test('exists in the notifications settings', () => {
+        expect(findSetting()).toBeDefined();
+    });
+
+    test.each(Object.keys(licenses))('is shown with %s', (name) => {
+        expect(evaluate(findSetting().isHidden, licenses[name], canWrite)).toBe(false);
+    });
+
+    test('can be edited by an admin with write access', () => {
+        expect(evaluate(findSetting().isDisabled, licenses['no license'], canWrite)).toBe(false);
+    });
+
+    test('is read-only without write access', () => {
+        expect(evaluate(findSetting().isDisabled, licenses['no license'], readOnly)).toBe(true);
+    });
+});
