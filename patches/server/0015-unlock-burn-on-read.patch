+// TestFillInPostPropsBurnOnReadWithoutLicense locks in the Mattermore unlock: the
+// Enterprise Advanced licence check is gone from FillInPostProps, while the
+// feature-flag and service-setting gates that protect the feature remain.
+func TestFillInPostPropsBurnOnReadWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+
+	enableBurnOnRead := func(th *TestHelper) {
+		th.App.UpdateConfig(func(cfg *model.Config) {
+			cfg.FeatureFlags.BurnOnRead = true
+			cfg.ServiceSettings.EnableBurnOnRead = new(true)
+		})
+	}
+
+	t.Run("accepts a burn-on-read post with no licence installed", func(t *testing.T) {
+		mainHelper.Parallel(t)
+		th := Setup(t).InitBasic(t)
+
+		appErr := th.App.Srv().RemoveLicense()
+		require.Nil(t, appErr)
+		enableBurnOnRead(th)
+
+		post := &model.Post{
+			UserId:    th.BasicUser.Id,
+			ChannelId: th.BasicChannel.Id,
+			Message:   "burn after reading",
+			Type:      model.PostTypeBurnOnRead,
+		}
+
+		appErr = th.App.FillInPostProps(th.Context, post, th.BasicChannel)
+		require.Nil(t, appErr)
+		require.NotNil(t, post.GetProp(model.PostPropsExpireAt))
+		require.NotNil(t, post.GetProp(model.PostPropsReadDurationSeconds))
+	})
+
+	t.Run("creates a burn-on-read post end to end with no licence installed", func(t *testing.T) {
+		mainHelper.Parallel(t)
+		th := Setup(t).InitBasic(t)
+
+		appErr := th.App.Srv().RemoveLicense()
+		require.Nil(t, appErr)
+		enableBurnOnRead(th)
+
+		created, _, appErr := th.App.CreatePost(th.Context, &model.Post{
+			UserId:    th.BasicUser.Id,
+			ChannelId: th.BasicChannel.Id,
+			Message:   "burn after reading",
+			Type:      model.PostTypeBurnOnRead,
+		}, th.BasicChannel, model.CreatePostFlags{SetOnline: false})
+		require.Nil(t, appErr)
+		require.Equal(t, model.PostTypeBurnOnRead, created.Type)
+	})
+
+	t.Run("unlicensed recipient can reveal and author can permanently burn", func(t *testing.T) {
+		mainHelper.Parallel(t)
+		th := Setup(t).InitBasic(t)
+		require.Nil(t, th.App.Srv().RemoveLicense())
+		enableBurnOnRead(th)
+		th.AddUserToChannel(t, th.BasicUser2, th.BasicChannel)
+		post, _, appErr := th.App.CreatePost(th.Context, &model.Post{
+			UserId: th.BasicUser.Id, ChannelId: th.BasicChannel.Id,
+			Message: "synthetic temporary message", Type: model.PostTypeBurnOnRead,
+		}, th.BasicChannel, model.CreatePostFlags{})
+		require.Nil(t, appErr)
+		_, err := th.App.Srv().Store().TemporaryPost().Get(th.Context, post.Id, true)
+		require.NoError(t, err)
+		revealed, appErr := th.App.RevealPost(th.Context, post, th.BasicUser2.Id, "")
+		require.Nil(t, appErr)
+		require.Equal(t, "synthetic temporary message", revealed.Message)
+		receipt, err := th.App.Srv().Store().ReadReceipt().Get(th.Context, post.Id, th.BasicUser2.Id)
+		require.NoError(t, err)
+		require.Equal(t, revealed.Metadata.ExpireAt, receipt.ExpireAt)
+		require.Greater(t, receipt.ExpireAt, model.GetMillis())
+		require.Nil(t, th.App.BurnPost(th.Context, post, th.BasicUser.Id, ""))
+		_, err = th.App.Srv().Store().TemporaryPost().Get(th.Context, post.Id, true)
+		require.Error(t, err)
+	})
+
+	t.Run("still refuses when the service setting is disabled", func(t *testing.T) {
+		mainHelper.Parallel(t)
+		th := Setup(t).InitBasic(t)
+
+		appErr := th.App.Srv().RemoveLicense()
+		require.Nil(t, appErr)
+		th.App.UpdateConfig(func(cfg *model.Config) {
+			cfg.FeatureFlags.BurnOnRead = true
+			cfg.ServiceSettings.EnableBurnOnRead = new(false)
+		})
+
+		post := &model.Post{
+			UserId:    th.BasicUser.Id,
+			ChannelId: th.BasicChannel.Id,
+			Message:   "burn after reading",
+			Type:      model.PostTypeBurnOnRead,
+		}
+
+		appErr = th.App.FillInPostProps(th.Context, post, th.BasicChannel)
+		require.NotNil(t, appErr)
+		require.Equal(t, "api.post.fill_in_post_props.burn_on_read.config.app_error", appErr.Id)
+	})
+}
