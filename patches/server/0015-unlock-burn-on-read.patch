+	} {
+		cfg.ServiceSettings.EnableBurnOnRead = &tc.setting
+		cfg.FeatureFlags.BurnOnRead = tc.flag
+		assert.Equal(t, tc.want, GenerateClientConfig(cfg, "", nil)["EnableBurnOnRead"])
+	}
+}
