@@ -6,2 +6,3 @@ import React from 'react';
 import GeneralConstants from 'mattermost-redux/constants/general';
+import Permissions from 'mattermost-redux/constants/permissions';
 
@@ -282,2 +283,40 @@ describe('components/admin_console/permission_schemes_settings/permission_tree',
     });
+
+    describe('should show the permissions of the unlocked features without a license', () => {
+        const idsOf = (permissions: unknown[]): string[] => permissions.flatMap((p) => {
+            if (typeof p === 'string') {
+                return [p];
+            }
+            const group = p as {id?: string; permissions?: unknown[]};
+            return [group.id || '', ...idsOf(group.permissions || [])];
+        });
+
+        test.each([
+            ['no license', {IsLicensed: 'false'}],
+            ['an empty license record', {}],
+            ['Professional', {IsLicensed: 'true', SkuShortName: LicenseSkus.Professional}],
+        ])('%s', (_name, license) => {
+            renderWithContext(
+                <PermissionsTree
+                    {...defaultProps}
+                    license={license}
+                    config={{...defaultProps.config, EnableCustomGroups: 'true'}}
+                />,
+            );
+
+            const groups = PermissionGroup.mock.calls[0][0].permissions as unknown[];
+            const ids = idsOf(groups);
+
+            // channel bookmarks, channel banners and group mentions
+            expect(ids).toContain('manage_public_channel_bookmarks');
+            expect(ids).toContain('manage_private_channel_bookmarks');
+            expect(ids).toContain(Permissions.MANAGE_PUBLIC_CHANNEL_BANNER);
+            expect(ids).toContain(Permissions.MANAGE_PRIVATE_CHANNEL_BANNER);
+            expect(ids).toContain(Permissions.USE_GROUP_MENTIONS);
+
+            // features that are not unlocked stay out
+            expect(ids).not.toContain(Permissions.MANAGE_PUBLIC_CHANNEL_AUTO_TRANSLATION);
+            expect(ids).not.toContain(Permissions.MANAGE_CHANNEL_ACCESS_RULES);
+        });
+    });
 });
