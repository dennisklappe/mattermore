+func TestListGroupsByNameWithLicenseWithoutLDAPGroups(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+
+	// A server downgraded from Enterprise keeps its LDAP rows. A licence without the LDAP groups
+	// feature must hide them exactly as no licence does.
+	lic := model.NewTestLicenseSKU(model.LicenseShortSkuProfessional)
+	*lic.Features.LDAPGroups = false
+	th.App.Srv().SetLicense(lic)
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.EnableCustomGroups = true })
+
+	ldapID := model.NewId()
+	ldap, appErr := th.App.CreateGroup(&model.Group{DisplayName: "ldap_" + ldapID, Name: new("ldap" + ldapID), Source: model.GroupSourceLdap, RemoteId: new(model.NewId()), AllowReference: true})
+	require.Nil(t, appErr)
+	customID := model.NewId()
+	custom, appErr := th.App.CreateGroup(&model.Group{DisplayName: "custom_" + customID, Name: new("custom" + customID), Source: model.GroupSourceCustom, AllowReference: true})
+	require.Nil(t, appErr)
+
+	t.Run("names endpoint returns only the custom group", func(t *testing.T) {
+		groups, resp, err := th.Client.GetGroupsByNames(context.Background(), []string{*ldap.Name, *custom.Name})
+		require.NoError(t, err)
+		CheckOKStatus(t, resp)
+		require.Len(t, groups, 1)
+		assert.Equal(t, custom.Id, groups[0].Id)
+	})
+
+	t.Run("list endpoint returns no LDAP group", func(t *testing.T) {
+		groups, resp, err := th.Client.GetGroups(context.Background(), model.GroupSearchOpts{Q: ldapID, FilterAllowReference: true})
+		require.NoError(t, err)
+		CheckOKStatus(t, resp)
+		for _, g := range groups {
+			assert.NotEqual(t, ldap.Id, g.Id)
+		}
+	})
+
+	t.Run("an explicit LDAP source is forbidden", func(t *testing.T) {
+		_, resp, err := th.Client.GetGroups(context.Background(), model.GroupSearchOpts{Source: model.GroupSourceLdap})
+		require.Error(t, err)
+		CheckForbiddenStatus(t, resp)
+	})
+
+	t.Run("total count excludes LDAP groups", func(t *testing.T) {
+		th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.EnableCustomGroups = true })
+		customCount, err := th.App.Srv().Store().Group().GroupCountBySource(model.GroupSourceCustom)
+		require.NoError(t, err)
+		allCount, err := th.App.Srv().Store().Group().GroupCount()
+		require.NoError(t, err)
+		require.Greater(t, allCount, customCount, "the test needs an LDAP group to make the counts differ")
+
+		r, err := th.Client.DoAPIGet(context.Background(), "/groups?include_total_count=true", "")
+		require.NoError(t, err)
+		defer r.Body.Close()
+		var withCount model.GroupsWithCount
+		require.NoError(t, json.NewDecoder(r.Body).Decode(&withCount))
+		assert.Equal(t, customCount, withCount.TotalCount)
+	})
+
+	t.Run("names endpoint refuses custom names when custom groups are disabled", func(t *testing.T) {
+		th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.EnableCustomGroups = false })
+		_, resp, err := th.Client.GetGroupsByNames(context.Background(), []string{*custom.Name})
+		require.Error(t, err)
+		CheckBadRequestStatus(t, resp)
+	})
+}
