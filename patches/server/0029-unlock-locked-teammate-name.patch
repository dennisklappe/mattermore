@@ -0,0 +1,29 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {AdminConfig, ClientLicense} from '@mattermost/types/config';
+
+import AdminDefinition from './admin_definition';
+import type {AdminDefinitionSetting, AdminDefinitionSubSection, Check} from './types';
+
+const licenses: Record<string, ClientLicense> = {
+    'no license': {IsLicensed: 'false'} as ClientLicense,
+    'an empty license record': {} as ClientLicense,
+    'a license without the feature': {IsLicensed: 'true', LockTeammateNameDisplay: 'false'} as ClientLicense,
+};
+
+describe('AdminDefinition - Lock Teammate Name Display', () => {
+    const users = AdminDefinition.site.subsections.users_and_teams as AdminDefinitionSubSection;
+    const settings = (users.schema as {settings: AdminDefinitionSetting[]}).settings;
+    const setting = settings.find((s) => s.key === 'TeamSettings.LockTeammateNameDisplay') as AdminDefinitionSetting;
+
+    test('exists', () => {
+        expect(setting).toBeDefined();
+    });
+
+    test.each(Object.keys(licenses))('is visible with %s', (name) => {
+        const hidden = setting.isHidden;
+        const result = typeof hidden === 'function' ? (hidden as Extract<Check, (...args: any[]) => boolean>)({} as Partial<AdminConfig>, {}, licenses[name], true, {}) : Boolean(hidden);
+        expect(result).toBe(false);
+    });
+});
