index a6e40117..1c584872 100644
--- a/server/channels/api4/user_test.go
+++ b/server/channels/api4/user_test.go
@@ -3203,2 +3203,31 @@ func TestUpdateUserRoles(t *testing.T) {
 
+func TestUpdateUserRolesNewSystemRolesWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	th.RemoveLicense(t)
+	require.Nil(t, th.App.Srv().License())
+
+	for _, roleID := range model.NewSystemRoleIDs {
+		t.Run(roleID, func(t *testing.T) {
+			th.TestForSystemAdminAndLocal(t, func(t *testing.T, client *model.Client4) {
+				_, err := client.UpdateUserRoles(context.Background(), th.BasicUser.Id, model.SystemUserRoleId+" "+roleID)
+				require.NoError(t, err)
+
+				user, appErr := th.App.GetUser(th.Context, th.BasicUser.Id)
+				require.Nil(t, appErr)
+				assert.Contains(t, strings.Fields(user.Roles), roleID)
+
+				_, err = client.UpdateUserRoles(context.Background(), th.BasicUser.Id, model.SystemUserRoleId)
+				require.NoError(t, err)
+			})
+		})
+	}
+
+	t.Run("a regular user still cannot assign them", func(t *testing.T) {
+		resp, err := th.Client.UpdateUserRoles(context.Background(), th.BasicUser2.Id, model.SystemUserRoleId+" "+model.SystemManagerRoleId)
+		require.Error(t, err)
+		CheckForbiddenStatus(t, resp)
+	})
+}
