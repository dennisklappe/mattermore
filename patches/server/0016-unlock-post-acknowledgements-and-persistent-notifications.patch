new file mode 100644
index 00000000..008bbe94
--- /dev/null
+++ b/server/channels/jobs/post_persistent_notifications/scheduler_test.go
@@ -0,0 +1,37 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package post_persistent_notifications
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+func TestSchedulerEnabledWithoutLicense(t *testing.T) {
+	scheduler := MakeScheduler(nil)
+
+	cfg := &model.Config{}
+	cfg.SetDefaults()
+
+	t.Run("enabled by the settings alone, with no license", func(t *testing.T) {
+		*cfg.ServiceSettings.PostPriority = true
+		*cfg.ServiceSettings.AllowPersistentNotifications = true
+		assert.True(t, scheduler.Enabled(cfg))
+	})
+
+	t.Run("disabled when persistent notifications are off", func(t *testing.T) {
+		*cfg.ServiceSettings.PostPriority = true
+		*cfg.ServiceSettings.AllowPersistentNotifications = false
+		assert.False(t, scheduler.Enabled(cfg))
+	})
+
+	t.Run("disabled when message priority is off", func(t *testing.T) {
+		*cfg.ServiceSettings.PostPriority = false
+		*cfg.ServiceSettings.AllowPersistentNotifications = true
+		assert.False(t, scheduler.Enabled(cfg))
+	})
+}
