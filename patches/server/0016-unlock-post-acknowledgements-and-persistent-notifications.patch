+func TestPostPriorityCheckWithoutLicense(t *testing.T) {
+	user := &model.User{Id: model.NewId()}
+	important := "important"
+	urgent := model.PostPriorityUrgent
+
+	t.Run("requesting an acknowledgement needs no license", func(t *testing.T) {
+		priority := &model.PostPriority{Priority: &important, RequestedAck: model.NewPointer(true)}
+		assert.Nil(t, postPriorityCheck(user, priority, "", true, true, false))
+	})
+
+	t.Run("requesting an acknowledgement is still refused when priority is disabled", func(t *testing.T) {
+		priority := &model.PostPriority{Priority: &important, RequestedAck: model.NewPointer(true)}
+		assert.NotNil(t, postPriorityCheck(user, priority, "", false, true, false))
+	})
+
+	t.Run("persistent notifications need no license", func(t *testing.T) {
+		priority := &model.PostPriority{Priority: &urgent, PersistentNotifications: model.NewPointer(true)}
+		assert.Nil(t, postPriorityCheck(user, priority, "", true, true, false))
+	})
+
+	t.Run("persistent notifications still require the setting", func(t *testing.T) {
+		priority := &model.PostPriority{Priority: &urgent, PersistentNotifications: model.NewPointer(true)}
+		assert.NotNil(t, postPriorityCheck(user, priority, "", true, false, false))
+	})
+
+	t.Run("persistent notifications still require urgent priority", func(t *testing.T) {
+		priority := &model.PostPriority{Priority: &important, PersistentNotifications: model.NewPointer(true)}
+		assert.NotNil(t, postPriorityCheck(user, priority, "", true, true, false))
+	})
+}
