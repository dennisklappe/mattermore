+
+func TestContentFlaggingWithoutLicense(t *testing.T) {
+	th := Setup(t).InitBasic(t)
+	th.RemoveLicense(t)
+	require.Nil(t, th.App.Srv().License())
+
+	appErr := setBasicCommonReviewerConfig(th)
+	require.Nil(t, appErr)
+
+	t.Run("an admin can read the settings", func(t *testing.T) {
+		settings, resp, err := th.SystemAdminClient.GetContentFlaggingSettings(context.Background())
+		require.NoError(t, err)
+		require.Equal(t, http.StatusOK, resp.StatusCode)
+		require.NotNil(t, settings.EnableContentFlagging)
+		require.True(t, *settings.EnableContentFlagging)
+	})
+
+	t.Run("a user can flag a post", func(t *testing.T) {
+		post := th.CreatePost(t)
+		resp, err := th.Client.FlagPostForContentReview(context.Background(), post.Id, &model.FlagContentRequest{
+			Reason:  "Classification mismatch",
+			Comment: "This is sensitive data",
+		})
+		require.NoError(t, err)
+		require.Equal(t, http.StatusOK, resp.StatusCode)
+	})
+
+	t.Run("permissions still apply without a license", func(t *testing.T) {
+		settings, resp, err := th.Client.GetContentFlaggingSettings(context.Background())
+		require.Error(t, err)
+		require.Equal(t, http.StatusForbidden, resp.StatusCode)
+		require.Nil(t, settings)
+	})
+}
