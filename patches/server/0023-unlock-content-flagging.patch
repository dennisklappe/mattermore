+func TestGetClientConfigContentFlaggingWithoutLicense(t *testing.T) {
+	t.Parallel()
+
+	for name, tc := range map[string]struct {
+		flag     bool
+		enabled  bool
+		expected string
+	}{
+		"feature flag and setting on": {flag: true, enabled: true, expected: "true"},
+		"setting off":                 {flag: true, enabled: false, expected: "false"},
+		"feature flag off":            {flag: false, enabled: true, expected: "false"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			cfg := &model.Config{}
+			cfg.SetDefaults()
+			cfg.FeatureFlags.ContentFlagging = tc.flag
+			cfg.ContentFlaggingSettings.EnableContentFlagging = model.NewPointer(tc.enabled)
+
+			props := GenerateClientConfig(cfg, "", nil)
+			assert.Equal(t, tc.expected, props["ContentFlaggingEnabled"])
+		})
+	}
+}
