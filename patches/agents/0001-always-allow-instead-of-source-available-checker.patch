new file mode 100644
index 0000000..50b699a
--- /dev/null
+++ b/license/licensetest/checker.go
@@ -0,0 +1,95 @@
+// Copyright (c) 2026-present Mattermore contributors. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// Package licensetest holds the test-only half of the licence checker. The real
+// checker never inspects a licence. These helpers do, so the plugin's own tests
+// can keep exercising every tier.
+package licensetest
+
+import (
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/plugin/plugintest"
+	"github.com/mattermost/mattermost/server/public/pluginapi"
+
+	"github.com/mattermost/mattermost-plugin-agents/v2/license"
+)
+
+// AllLevels lists every level in ascending order, for tests that walk the tiers.
+var AllLevels = []license.Level{
+	license.LevelUnlicensed,
+	license.LevelProfessional,
+	license.LevelEnterprise,
+	license.LevelEnterpriseAdvanced,
+}
+
+// LevelFor maps a server configuration and licence to the tier the plugin's own
+// documentation gives it. Entry counts as Enterprise, legacy E10 as Professional
+// and E20 as Enterprise, and a development server (testing and developer
+// settings both on) reports the top level. Only tests use it.
+func LevelFor(config *model.Config, lic *model.License) license.Level {
+	if pluginapi.IsConfiguredForDevelopment(config) {
+		return license.LevelEnterpriseAdvanced
+	}
+	if lic == nil {
+		return license.LevelUnlicensed
+	}
+
+	switch lic.SkuShortName {
+	case model.LicenseShortSkuEnterpriseAdvanced:
+		return license.LevelEnterpriseAdvanced
+	case model.LicenseShortSkuEnterprise, model.LicenseShortSkuMattermostEntry, model.LicenseShortSkuE20:
+		return license.LevelEnterprise
+	case model.LicenseShortSkuProfessional, model.LicenseShortSkuE10:
+		return license.LevelProfessional
+	}
+
+	if features := lic.Features; features != nil {
+		if model.SafeDereference(features.FutureFeatures) {
+			return license.LevelEnterprise
+		}
+		if model.SafeDereference(features.LDAP) {
+			return license.LevelProfessional
+		}
+	}
+	return license.LevelUnlicensed
+}
+
+// NewLicenseChecker returns a checker whose level follows the licence the plugin
+// API reports, read again on every call so a test can swap the licence under it.
+func NewLicenseChecker(client *pluginapi.Client) *license.LicenseChecker {
+	if client == nil {
+		return license.NewCheckerFunc(func() license.Level { return license.LevelUnlicensed })
+	}
+	return license.NewCheckerFunc(func() license.Level {
+		return LevelFor(client.Configuration.GetConfig(), client.System.GetLicense())
+	})
+}
+
+// LicenseFor returns a server licence that resolves to level. The free tier is an
+// empty licence.
+func LicenseFor(level license.Level) *model.License {
+	switch level {
+	case license.LevelProfessional:
+		return &model.License{SkuShortName: model.LicenseShortSkuProfessional}
+	case license.LevelEnterprise:
+		return &model.License{SkuShortName: model.LicenseShortSkuEnterprise}
+	case license.LevelEnterpriseAdvanced:
+		return &model.License{SkuShortName: model.LicenseShortSkuEnterpriseAdvanced}
+	default:
+		return &model.License{}
+	}
+}
+
+// StubLicense registers the GetLicense and GetConfig expectations a checker built
+// over mockAPI needs to report level.
+func StubLicense(mockAPI *plugintest.API, level license.Level) {
+	mockAPI.On("GetLicense").Return(LicenseFor(level)).Maybe()
+	mockAPI.On("GetConfig").Return(&model.Config{}).Maybe()
+}
+
+// CheckerAt returns a checker that reports level.
+func CheckerAt(level license.Level) *license.LicenseChecker {
+	mockAPI := &plugintest.API{}
+	StubLicense(mockAPI, level)
+	return NewLicenseChecker(pluginapi.NewClient(mockAPI, nil))
+}
diff --git a/license/licensetest/checker_test.go b/license/licensetest/checker_test.go
new file mode 100644
index 0000000..fcbab85
--- /dev/null
+++ b/license/licensetest/checker_test.go
@@ -0,0 +1,91 @@
+// Copyright (c) 2026-present Mattermore contributors. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package licensetest
+
+import (
+	"testing"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/plugin/plugintest"
+	"github.com/mattermost/mattermost/server/public/pluginapi"
+	"github.com/stretchr/testify/assert"
+
+	"github.com/mattermost/mattermost-plugin-agents/v2/license"
+)
+
+func developmentConfig() *model.Config {
+	cfg := &model.Config{}
+	cfg.ServiceSettings.EnableTesting = model.NewPointer(true)
+	cfg.ServiceSettings.EnableDeveloper = model.NewPointer(true)
+	return cfg
+}
+
+func TestLevelFor(t *testing.T) {
+	tests := []struct {
+		name    string
+		config  *model.Config
+		license *model.License
+		want    license.Level
+	}{
+		{name: "no licence installed", license: nil, want: license.LevelUnlicensed},
+		{name: "empty licence", license: &model.License{}, want: license.LevelUnlicensed},
+		{name: "unknown sku without features", license: &model.License{SkuShortName: "mystery"}, want: license.LevelUnlicensed},
+		{name: "professional", license: &model.License{SkuShortName: model.LicenseShortSkuProfessional}, want: license.LevelProfessional},
+		{name: "legacy E10 counts as professional", license: &model.License{SkuShortName: model.LicenseShortSkuE10}, want: license.LevelProfessional},
+		{name: "enterprise", license: &model.License{SkuShortName: model.LicenseShortSkuEnterprise}, want: license.LevelEnterprise},
+		{name: "legacy E20 counts as enterprise", license: &model.License{SkuShortName: model.LicenseShortSkuE20}, want: license.LevelEnterprise},
+		{name: "entry counts as enterprise", license: &model.License{SkuShortName: model.LicenseShortSkuMattermostEntry}, want: license.LevelEnterprise},
+		{name: "enterprise advanced", license: &model.License{SkuShortName: model.LicenseShortSkuEnterpriseAdvanced}, want: license.LevelEnterpriseAdvanced},
+		{
+			name:    "unknown sku with future features counts as enterprise",
+			license: &model.License{SkuShortName: "mystery", Features: &model.Features{FutureFeatures: model.NewPointer(true)}},
+			want:    license.LevelEnterprise,
+		},
+		{
+			name:    "unknown sku with ldap counts as professional",
+			license: &model.License{SkuShortName: "mystery", Features: &model.Features{LDAP: model.NewPointer(true)}},
+			want:    license.LevelProfessional,
+		},
+		{name: "development server is the top level", license: &model.License{}, config: developmentConfig(), want: license.LevelEnterpriseAdvanced},
+		{
+			name:    "testing alone is not a development server",
+			license: &model.License{},
+			config: func() *model.Config {
+				cfg := &model.Config{}
+				cfg.ServiceSettings.EnableTesting = model.NewPointer(true)
+				return cfg
+			}(),
+			want: license.LevelUnlicensed,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, LevelFor(tc.config, tc.license))
+		})
+	}
+}
+
+func TestCheckerFollowsTheMockedServerLicense(t *testing.T) {
+	mockAPI := &plugintest.API{}
+	mockAPI.On("GetConfig").Return(&model.Config{}).Maybe()
+	checker := NewLicenseChecker(pluginapi.NewClient(mockAPI, nil))
+
+	mockAPI.On("GetLicense").Return(&model.License{SkuShortName: model.LicenseShortSkuProfessional}).Once()
+	assert.Equal(t, license.LevelProfessional, checker.Level())
+
+	// The level is read on every call, so a test can change the licence under a live checker.
+	mockAPI.On("GetLicense").Return(&model.License{SkuShortName: model.LicenseShortSkuEnterprise}).Once()
+	assert.Equal(t, license.LevelEnterprise, checker.Level())
+}
+
+func TestCheckerAtEveryLevel(t *testing.T) {
+	for _, level := range AllLevels {
+		checker := CheckerAt(level)
+		assert.Equal(t, level, checker.Level())
+		for _, capability := range []license.Capability{license.CapMultiplayerChannels, license.CapSemanticSearch, license.CapChannelAutoReply} {
+			assert.Equal(t, level >= license.RequiredLevel(capability), checker.Allows(capability), "%s at %s", capability, level)
+		}
+	}
+}
