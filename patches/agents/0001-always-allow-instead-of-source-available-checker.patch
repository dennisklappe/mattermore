new file mode 100644
index 0000000..90479ee
--- /dev/null
+++ b/license/license.go
@@ -0,0 +1,266 @@
+// Copyright (c) 2026-present Mattermore contributors. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// Package license decides which plugin capabilities a server may use. It stands
+// in for the Source Available enterprise package. Mattermore ships every
+// capability to every server, so the checker answers yes to everything and no
+// licence is inspected, the same way the calls plugin's checker does.
+package license
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/mattermost/mattermost/server/public/pluginapi"
+)
+
+// ErrNotLicensed is wrapped by every error that reports a missing capability.
+var ErrNotLicensed = errors.New("license does not support this feature")
+
+// Level is a licence tier. A higher level includes everything below it.
+type Level int
+
+const (
+	LevelUnlicensed Level = iota
+	LevelProfessional
+	LevelEnterprise
+	LevelEnterpriseAdvanced
+)
+
+var levelNames = map[Level]string{
+	LevelUnlicensed:         "Free",
+	LevelProfessional:       "Professional",
+	LevelEnterprise:         "Enterprise",
+	LevelEnterpriseAdvanced: "Enterprise Advanced",
+}
+
+var levelKeys = map[Level]string{
+	LevelUnlicensed:         "unlicensed",
+	LevelProfessional:       "professional",
+	LevelEnterprise:         "enterprise",
+	LevelEnterpriseAdvanced: "enterprise_advanced",
+}
+
+// String is the name shown to administrators.
+func (l Level) String() string {
+	if name, ok := levelNames[l]; ok {
+		return name
+	}
+	return levelNames[LevelUnlicensed]
+}
+
+// Key is the stable identifier carried in API error payloads.
+func (l Level) Key() string {
+	if key, ok := levelKeys[l]; ok {
+		return key
+	}
+	return levelKeys[LevelUnlicensed]
+}
+
+// Capability names one licensable piece of the plugin.
+type Capability string
+
+const (
+	CapMultiplayerChannels  Capability = "multiplayer_channels"
+	CapThreadSummarization  Capability = "thread_summarization"
+	CapChannelSummarization Capability = "channel_summarization"
+	CapProviderWebSearch    Capability = "provider_web_search"
+	CapAgentAccessControls  Capability = "agent_access_controls"
+	CapTokenAccounting      Capability = "token_accounting"
+	CapSovereignWebSearch   Capability = "sovereign_web_search"
+	CapToolApprovalPolicies Capability = "tool_approval_policies"
+	CapRemoteMCP            Capability = "remote_mcp"
+	CapSemanticSearch       Capability = "semantic_search"
+	CapMeetings             Capability = "meetings"
+	CapMCPServiceAccount    Capability = "mcp_service_account"
+	CapSharedPrompts        Capability = "shared_prompts"
+	CapMultipleLLMServices  Capability = "multiple_llm_services"
+	CapModelFallback        Capability = "model_fallback"
+	CapStateChangingTools   Capability = "state_changing_tools"
+	CapChannelAutoReply     Capability = "channel_auto_reply"
+	CapAttributeBasedAccess Capability = "attribute_based_access"
+
+	capabilityUnknownDisplay = "This feature"
+)
+
+// requiredLevels is the published tier chart (docs/admin_guide.md).
+var requiredLevels = map[Capability]Level{
+	CapMultiplayerChannels:  LevelProfessional,
+	CapThreadSummarization:  LevelProfessional,
+	CapChannelSummarization: LevelProfessional,
+	CapProviderWebSearch:    LevelProfessional,
+	CapAgentAccessControls:  LevelProfessional,
+	CapTokenAccounting:      LevelProfessional,
+
+	CapMultipleLLMServices:  LevelEnterprise,
+	CapStateChangingTools:   LevelEnterprise,
+	CapSovereignWebSearch:   LevelEnterprise,
+	CapToolApprovalPolicies: LevelEnterprise,
+	CapRemoteMCP:            LevelEnterprise,
+	CapSemanticSearch:       LevelEnterprise,
+	CapMeetings:             LevelEnterprise,
+	CapMCPServiceAccount:    LevelEnterprise,
+	CapSharedPrompts:        LevelEnterprise,
+
+	CapChannelAutoReply:     LevelEnterpriseAdvanced,
+	CapAttributeBasedAccess: LevelEnterpriseAdvanced,
+	CapModelFallback:        LevelEnterpriseAdvanced,
+}
+
+var displayNames = map[Capability]string{
+	CapMultiplayerChannels:  "Multiplayer agents in channels",
+	CapThreadSummarization:  "Thread summarization",
+	CapChannelSummarization: "Channel and unread summarization",
+	CapProviderWebSearch:    "Provider-native web search",
+	CapAgentAccessControls:  "Agent access controls",
+	CapTokenAccounting:      "Token accounting",
+	CapSovereignWebSearch:   "Sovereign web search",
+	CapToolApprovalPolicies: "Tool approval policies",
+	CapRemoteMCP:            "Remote and external MCP servers",
+	CapSemanticSearch:       "Semantic AI search",
+	CapMeetings:             "Meeting transcription and summaries",
+	CapMCPServiceAccount:    "MCP service-account authentication",
+	CapSharedPrompts:        "Shared prompt libraries",
+	CapMultipleLLMServices:  "Multiple LLM services",
+	CapModelFallback:        "LLM fallback chains",
+	CapStateChangingTools:   "State-changing Mattermost tools",
+	CapChannelAutoReply:     "Channel agent auto-reply",
+	CapAttributeBasedAccess: "Attribute-based access control",
+}
+
+// RequiredLevel returns the lowest level that includes the capability. A
+// capability the chart does not know needs the top level, so a typo never
+// opens anything.
+func RequiredLevel(capability Capability) Level {
+	if level, ok := requiredLevels[capability]; ok {
+		return level
+	}
+	return LevelEnterpriseAdvanced
+}
+
+// DisplayName is the administrator-facing name of the capability.
+func DisplayName(capability Capability) string {
+	if name, ok := displayNames[capability]; ok {
+		return name
+	}
+	return capabilityUnknownDisplay
+}
+
+// LicenseError reports that a capability is not available at the current level.
+type LicenseError struct {
+	Capability    Capability
+	RequiredLevel Level
+	CurrentLevel  Level
+}
+
+// NewLicenseError builds the error for a capability denied at the given level.
+func NewLicenseError(capability Capability, current Level) *LicenseError {
+	return &LicenseError{Capability: capability, RequiredLevel: RequiredLevel(capability), CurrentLevel: current}
+}
+
+func (e *LicenseError) Error() string {
+	return fmt.Sprintf("%s needs a Mattermost %s license or higher, and this server is at %s",
+		DisplayName(e.Capability), e.RequiredLevel, e.CurrentLevel)
+}
+
+func (e *LicenseError) Unwrap() error { return ErrNotLicensed }
+
+const (
+	freeAgentLimit         = 1
+	professionalAgentLimit = 3
+	baseServiceLimit       = 1
+)
+
+// AgentLimitFor returns how many agents a level may have. The bool is false
+// when the level is uncapped.
+func AgentLimitFor(level Level) (int, bool) {
+	switch level {
+	case LevelUnlicensed:
+		return freeAgentLimit, true
+	case LevelProfessional:
+		return professionalAgentLimit, true
+	default:
+		return 0, false
+	}
+}
+
+// ServiceLimitFor returns how many LLM services a level may have. The bool is
+// false when the level is uncapped.
+func ServiceLimitFor(level Level) (int, bool) {
+	if level < LevelEnterprise {
+		return baseServiceLimit, true
+	}
+	return 0, false
+}
+
+type agentLimitError struct {
+	limit int
+	cause *LicenseError
+}
+
+func (e *agentLimitError) Error() string {
+	noun := "AI agents"
+	if e.limit == 1 {
+		noun = "AI agent"
+	}
+	return fmt.Sprintf("a server at %s level may have at most %d %s", e.cause.CurrentLevel, e.limit, noun)
+}
+
+// Unwrap exposes the *LicenseError, so callers can read the level that lifts the cap.
+func (e *agentLimitError) Unwrap() error { return e.cause }
+
+// AgentLimitError is returned when creating another agent would pass the cap. It
+// names the next level up as the one that allows more.
+func AgentLimitError(current Level) error {
+	limit, _ := AgentLimitFor(current)
+	return &agentLimitError{
+		limit: limit,
+		cause: &LicenseError{RequiredLevel: current + 1, CurrentLevel: current},
+	}
+}
+
+// LicenseChecker answers capability questions. Mattermore ships every capability to
+// every server, so the real checker never looks at a licence: each answer is yes.
+// A nil checker is a wiring mistake and reports the free tier, so it fails closed.
+type LicenseChecker struct {
+	levelFn func() Level
+}
+
+// NewLicenseChecker returns the checker the plugin runs with. It ignores the
+// plugin client, because there is no licence to read.
+func NewLicenseChecker(_ *pluginapi.Client) *LicenseChecker {
+	return &LicenseChecker{levelFn: func() Level { return LevelEnterpriseAdvanced }}
+}
+
+// NewCheckerFunc returns a checker whose level comes from fn. It exists so the
+// plugin's tests can exercise every tier. The plugin itself never calls it.
+func NewCheckerFunc(fn func() Level) *LicenseChecker {
+	return &LicenseChecker{levelFn: fn}
+}
+
+// Level is the current level of the server.
+func (c *LicenseChecker) Level() Level {
+	if c == nil || c.levelFn == nil {
+		return LevelUnlicensed
+	}
+	return c.levelFn()
+}
+
+// Allows reports whether the capability is available at the current level.
+func (c *LicenseChecker) Allows(capability Capability) bool {
+	return c.Level() >= RequiredLevel(capability)
+}
+
+// Check returns nil when the capability is available, otherwise a *LicenseError.
+func (c *LicenseChecker) Check(capability Capability) error {
+	if level := c.Level(); level < RequiredLevel(capability) {
+		return NewLicenseError(capability, level)
+	}
+	return nil
+}
+
+// AgentLimit is the agent cap at the current level.
+func (c *LicenseChecker) AgentLimit() (int, bool) { return AgentLimitFor(c.Level()) }
+
+// ServiceLimit is the LLM service cap at the current level.
+func (c *LicenseChecker) ServiceLimit() (int, bool) { return ServiceLimitFor(c.Level()) }
