index 0000000..eea12dc
--- /dev/null
+++ b/license/license_test.go
@@ -0,0 +1,155 @@
+// Copyright (c) 2026-present Mattermore contributors. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package license
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// The tier chart published in docs/admin_guide.md. The plugin's own tests use it
+// to walk the tiers, so it stays accurate even though nothing is gated here.
+func TestRequiredLevelMatchesPublishedChart(t *testing.T) {
+	chart := map[Capability]Level{
+		CapMultiplayerChannels:  LevelProfessional,
+		CapThreadSummarization:  LevelProfessional,
+		CapChannelSummarization: LevelProfessional,
+		CapProviderWebSearch:    LevelProfessional,
+		CapAgentAccessControls:  LevelProfessional,
+		CapTokenAccounting:      LevelProfessional,
+		CapMultipleLLMServices:  LevelEnterprise,
+		CapStateChangingTools:   LevelEnterprise,
+		CapSovereignWebSearch:   LevelEnterprise,
+		CapToolApprovalPolicies: LevelEnterprise,
+		CapRemoteMCP:            LevelEnterprise,
+		CapSemanticSearch:       LevelEnterprise,
+		CapMeetings:             LevelEnterprise,
+		CapMCPServiceAccount:    LevelEnterprise,
+		CapSharedPrompts:        LevelEnterprise,
+		CapChannelAutoReply:     LevelEnterpriseAdvanced,
+		CapAttributeBasedAccess: LevelEnterpriseAdvanced,
+		CapModelFallback:        LevelEnterpriseAdvanced,
+	}
+	for capability, want := range chart {
+		assert.Equal(t, want, RequiredLevel(capability), string(capability))
+		assert.NotEqual(t, capabilityUnknownDisplay, DisplayName(capability), string(capability))
+	}
+
+	t.Run("an unknown capability needs the top level", func(t *testing.T) {
+		assert.Equal(t, LevelEnterpriseAdvanced, RequiredLevel(Capability("typo")))
+		assert.Equal(t, capabilityUnknownDisplay, DisplayName(Capability("typo")))
+	})
+}
+
+func TestLevelNames(t *testing.T) {
+	assert.Equal(t, "Free", LevelUnlicensed.String())
+	assert.Equal(t, "Professional", LevelProfessional.String())
+	assert.Equal(t, "Enterprise", LevelEnterprise.String())
+	assert.Equal(t, "Enterprise Advanced", LevelEnterpriseAdvanced.String())
+	assert.Equal(t, "unlicensed", LevelUnlicensed.Key())
+	assert.Equal(t, "professional", LevelProfessional.Key())
+	assert.Equal(t, "enterprise", LevelEnterprise.Key())
+	assert.Equal(t, "enterprise_advanced", LevelEnterpriseAdvanced.Key())
+}
+
+// Mattermore ships every capability to every server, so the real checker answers
+// yes without looking at any licence.
+func TestCheckerAllowsEverything(t *testing.T) {
+	checker := NewLicenseChecker(nil)
+
+	assert.Equal(t, LevelEnterpriseAdvanced, checker.Level())
+	for capability := range requiredLevels {
+		assert.True(t, checker.Allows(capability), string(capability))
+		assert.NoError(t, checker.Check(capability), string(capability))
+	}
+
+	_, agentCapped := checker.AgentLimit()
+	assert.False(t, agentCapped)
+	_, serviceCapped := checker.ServiceLimit()
+	assert.False(t, serviceCapped)
+}
+
+func TestMissingCheckerFailsClosed(t *testing.T) {
+	var nilChecker *LicenseChecker
+	assert.Equal(t, LevelUnlicensed, nilChecker.Level())
+	assert.False(t, nilChecker.Allows(CapMeetings))
+}
+
+func TestCheckerAtEveryLevel(t *testing.T) {
+	for _, level := range []Level{LevelUnlicensed, LevelProfessional, LevelEnterprise, LevelEnterpriseAdvanced} {
+		for capability := range requiredLevels {
+			t.Run(level.Key()+"/"+string(capability), func(t *testing.T) {
+				checker := NewCheckerFunc(func() Level { return level })
+				want := level >= RequiredLevel(capability)
+				assert.Equal(t, want, checker.Allows(capability))
+
+				err := checker.Check(capability)
+				if want {
+					require.NoError(t, err)
+					return
+				}
+				var licErr *LicenseError
+				require.True(t, errors.As(err, &licErr))
+				assert.Equal(t, RequiredLevel(capability), licErr.RequiredLevel)
+				assert.Equal(t, level, licErr.CurrentLevel)
+				assert.True(t, errors.Is(err, ErrNotLicensed))
+			})
+		}
+	}
+}
+
+func TestLimitsPerLevel(t *testing.T) {
+	tests := []struct {
+		level       Level
+		agentLimit  int
+		agentCapped bool
+		svcLimit    int
+		svcCapped   bool
+	}{
+		{LevelUnlicensed, 1, true, 1, true},
+		{LevelProfessional, 3, true, 1, true},
+		{LevelEnterprise, 0, false, 0, false},
+		{LevelEnterpriseAdvanced, 0, false, 0, false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.level.Key(), func(t *testing.T) {
+			limit, capped := AgentLimitFor(tc.level)
+			assert.Equal(t, tc.agentCapped, capped)
+			if capped {
+				assert.Equal(t, tc.agentLimit, limit)
+			}
+			limit, capped = ServiceLimitFor(tc.level)
+			assert.Equal(t, tc.svcCapped, capped)
+			if capped {
+				assert.Equal(t, tc.svcLimit, limit)
+			}
+
+			checker := NewCheckerFunc(func() Level { return tc.level })
+			_, agentCapped := checker.AgentLimit()
+			assert.Equal(t, tc.agentCapped, agentCapped)
+			_, svcCapped := checker.ServiceLimit()
+			assert.Equal(t, tc.svcCapped, svcCapped)
+		})
+	}
+
+	t.Run("the agent limit error names the next level up", func(t *testing.T) {
+		for _, tc := range []struct{ from, wantRequired Level }{
+			{LevelUnlicensed, LevelProfessional},
+			{LevelProfessional, LevelEnterprise},
+		} {
+			err := AgentLimitError(tc.from)
+			require.Error(t, err)
+			assert.True(t, errors.Is(err, ErrNotLicensed))
+			assert.Contains(t, err.Error(), "AI agent")
+
+			var licErr *LicenseError
+			require.True(t, errors.As(err, &licErr))
+			assert.Equal(t, tc.wantRequired, licErr.RequiredLevel)
+			assert.Equal(t, tc.from, licErr.CurrentLevel)
+		}
+	})
+}
