@@ -0,0 +1,44 @@
+// Copyright (c) 2023-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {GlobalState} from '@mattermost/types/store';
+
+import {Capability, LicenseLevel, licenseAllows, requiredLevelFor} from './license';
+
+const everyCapability: Capability[] = [
+    'multiplayer_channels', 'thread_summarization', 'channel_summarization', 'provider_web_search',
+    'agent_access_controls', 'token_accounting', 'multiple_llm_services', 'model_fallback',
+    'state_changing_tools', 'sovereign_web_search', 'tool_approval_policies', 'remote_mcp',
+    'semantic_search', 'meetings', 'mcp_service_account', 'shared_prompts', 'channel_auto_reply',
+    'attribute_based_access',
+];
+
+const stateWith = (license: Record<string, string> | null) => ({
+    entities: {general: {license, config: {}}},
+} as unknown as GlobalState);
+
+// Mattermore ships every capability to every server, so no licence state changes
+// the answer, the same way the server side checker ignores the licence.
+describe('licenseAllows', () => {
+    const licenses: Array<[string, Record<string, string> | null]> = [
+        ['no licence installed', {IsLicensed: 'false'}],
+        ['a missing licence object', null],
+        ['an empty licence record', {}],
+        ['a professional licence', {IsLicensed: 'true', SkuShortName: 'professional'}],
+    ];
+
+    test.each(licenses)('%s allows every capability', (_name, license) => {
+        for (const capability of everyCapability) {
+            expect(licenseAllows(stateWith(license), capability)).toBe(true);
+        }
+    });
+});
+
+// The chart itself still drives the badges and wording in the System Console.
+describe('requiredLevelFor', () => {
+    test('follows the published tier chart', () => {
+        expect(requiredLevelFor('multiplayer_channels')).toBe(LicenseLevel.Professional);
+        expect(requiredLevelFor('semantic_search')).toBe(LicenseLevel.Enterprise);
+        expect(requiredLevelFor('channel_auto_reply')).toBe(LicenseLevel.EnterpriseAdvanced);
+    });
+});
