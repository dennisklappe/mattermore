+// Copyright (c) 2023-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package bifrost
+
+import (
+	"testing"
+
+	"github.com/maximhq/bifrost/core/schemas"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestOpenAICompatibleSessionHeader(t *testing.T) {
+	tests := []struct {
+		name       string
+		apiURL     string
+		orgID      string
+		wantHeader bool
+	}{
+		{name: "opencode gateway gets a session header", apiURL: "https://opencode.ai/inference/go/openai/v1", wantHeader: true},
+		{name: "opencode subdomain gets a session header", apiURL: "https://gateway.opencode.ai/v1", wantHeader: true},
+		{name: "other endpoint is untouched", apiURL: "https://api.openai.com/v1"},
+		{name: "lookalike host is untouched", apiURL: "https://notopencode.ai.example.com/v1"},
+		{name: "empty url is untouched"},
+		{name: "org id header is kept next to the session header", apiURL: "https://opencode.ai/inference/go/openai/v1", orgID: "org-1", wantHeader: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			acc := &providerAccount{ProviderSettings: ProviderSettings{Provider: schemas.OpenAI, APIURL: tt.apiURL, OrgID: tt.orgID}}
+			cfg, err := acc.GetConfigForProvider(acc.registeredName())
+			require.NoError(t, err)
+
+			got, ok := cfg.NetworkConfig.ExtraHeaders["x-opencode-session"]
+			assert.Equal(t, tt.wantHeader, ok)
+			if tt.wantHeader {
+				assert.NotEmpty(t, got)
+			}
+			if tt.orgID != "" {
+				assert.Equal(t, tt.orgID, cfg.NetworkConfig.ExtraHeaders["OpenAI-Organization"])
+			}
+		})
+	}
+}
