diff --git a/bifrost/account.go b/bifrost/account.go
index 8d8e8fd..62e67a3 100644
--- a/bifrost/account.go
+++ b/bifrost/account.go
@@ -8,3 +8,5 @@ import (
 	"fmt"
+	"net/url"
 	"slices"
+	"strings"
 	"time"
@@ -14,2 +16,14 @@ import (
 
+const openCodeSessionHeader = "x-opencode-session"
+
+// isOpenCodeURL reports whether apiURL points at opencode.ai or one of its subdomains.
+func isOpenCodeURL(apiURL string) bool {
+	u, err := url.Parse(apiURL)
+	if err != nil {
+		return false
+	}
+	host := strings.ToLower(u.Hostname())
+	return host == "opencode.ai" || strings.HasSuffix(host, ".opencode.ai")
+}
+
 // providerAccount implements the Bifrost Account interface for a single provider.
@@ -118,2 +132,12 @@ func (a *providerAccount) GetConfigForProvider(provider schemas.ModelProvider) (
 
+	// OpenCode's gateway refuses requests that carry no session id, so send a fixed one.
+	if a.Provider == schemas.OpenAI && isOpenCodeURL(a.APIURL) {
+		headers := make(map[string]string, len(networkConfig.ExtraHeaders)+1)
+		for k, v := range networkConfig.ExtraHeaders {
+			headers[k] = v
+		}
+		headers[openCodeSessionHeader] = "mattermost-agents"
+		networkConfig.ExtraHeaders = headers
+	}
+
 	// Configure retry logic with sensible defaults
