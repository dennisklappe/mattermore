+
+            peer.mediaMap = {0: {type: 'video', sender_id: 'session-a'}};
+
+            expect(emitted('remoteVideoStream')).toHaveLength(1);
+            expect(emitted('remoteVideoStream')[0][2]).toBe('session-a');
+            expect([...client.getRemoteVideoStreams().keys()]).toEqual(['session-a']);
