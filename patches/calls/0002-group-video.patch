+
+            peer.mediaMap = {
+                0: {type: 'screen', sender_id: 'session-a'},
+                1: {type: 'video', sender_id: ''},
+                2: {type: 'video', sender_id: 'session-c'},
+            };
+
+            expect(emitted('remoteVideoStream')).toHaveLength(0);
+            expect(client.getRemoteVideoStreams().size).toBe(0);
+        });
+
+        it('keeps multiple senders apart and does not re-emit unchanged ones', () => {
+            const peer = setupPeer([
+                makeTransceiver('0', makeTrack('track-a')),
