diff --git a/server/recording_api.go b/server/recording_api.go
index 377a89e..60a1707 100644
--- a/server/recording_api.go
+++ b/server/recording_api.go
@@ -73,6 +73,27 @@ func (p *Plugin) recJobTimeoutChecker(callID, jobID string) {
 	}
 }
 
+// autoStartRecording starts a recording nobody asked for, because an admin
+// asked for all of them. It takes the call lock itself and runs off the call
+// start path, so a slow or unreachable job service delays nothing: the call is
+// already live and announced by the time this runs.
+func (p *Plugin) autoStartRecording(callID, userID string) {
+	state, err := p.lockCallReturnState(callID)
+	if err != nil {
+		p.LogError("failed to lock call for automatic recording", "err", err.Error(), "callID", callID)
+		return
+	}
+	defer p.unlockCall(callID)
+
+	if state == nil {
+		return
+	}
+
+	if _, _, err := p.startRecordingJob(state, callID, userID); err != nil {
+		p.LogError("failed to start automatic recording", "err", err.Error(), "callID", callID)
+	}
+}
+
 func (p *Plugin) startRecordingJob(state *callState, callID, userID string) (rst *JobStateClient, rcode int, rerr error) {
 	if state.Recording != nil && state.Recording.EndAt == 0 {
 		return nil, http.StatusForbidden, fmt.Errorf("recording already in progress")
