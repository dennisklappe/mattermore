+++ b/cmd/transcriber/apis/openai/client_test.go
@@ -0,0 +1,229 @@
+package openai
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/mattermost/calls-transcriber/cmd/transcriber/transcribe"
+
+	"github.com/stretchr/testify/require"
+)
+
+func newTestClient(t *testing.T, url string) *Client {
+	t.Helper()
+
+	c, err := NewClient(Config{
+		BaseURL: url,
+		APIKey:  "test-api-key",
+		Model:   "whisper-1",
+		Timeout: time.Second,
+	})
+	require.NoError(t, err)
+	require.NotNil(t, c)
+
+	return c
+}
+
+func TestConfigIsValid(t *testing.T) {
+	t.Run("empty", func(t *testing.T) {
+		var cfg Config
+		require.Error(t, cfg.IsValid())
+	})
+
+	t.Run("invalid scheme", func(t *testing.T) {
+		cfg := Config{BaseURL: "ftp://example.com", Model: "whisper-1", Timeout: time.Second}
+		require.EqualError(t, cfg.IsValid(), `invalid BaseURL: invalid scheme "ftp"`)
+	})
+
+	t.Run("defaults", func(t *testing.T) {
+		var cfg Config
+		cfg.SetDefaults()
+		require.NoError(t, cfg.IsValid())
+		require.Equal(t, BaseURLDefault, cfg.BaseURL)
+		require.Equal(t, ModelDefault, cfg.Model)
+		require.Equal(t, TimeoutDefault, cfg.Timeout)
+		// An API key is not required as self-hosted services may not need one.
+		require.Empty(t, cfg.APIKey)
+	})
+}
+
+func TestConfigLogValueRedactsAPIKey(t *testing.T) {
+	var buf bytes.Buffer
+	logger := slog.New(slog.NewTextHandler(&buf, nil))
+
+	cfg := Config{BaseURL: BaseURLDefault, APIKey: "super-secret-key", Model: ModelDefault, Timeout: time.Second}
+	logger.Info("cfg", slog.Any("cfg", cfg))
+
+	require.NotContains(t, buf.String(), "super-secret-key")
+	require.Contains(t, buf.String(), "redacted")
+}
+
+func TestTranscribeSuccess(t *testing.T) {
+	var reqs atomic.Int32
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		reqs.Add(1)
+
+		require.Equal(t, http.MethodPost, r.Method)
+		require.Equal(t, "/v1/audio/transcriptions", r.URL.Path)
+		require.Equal(t, "Bearer test-api-key", r.Header.Get("Authorization"))
+
+		require.NoError(t, r.ParseMultipartForm(1<<20))
+		require.Equal(t, "whisper-1", r.FormValue("model"))
+		require.Equal(t, "verbose_json", r.FormValue("response_format"))
+
+		file, hdr, err := r.FormFile("file")
+		require.NoError(t, err)
+		defer file.Close()
+		require.Equal(t, "audio.wav", hdr.Filename)
+
+		data, err := io.ReadAll(file)
+		require.NoError(t, err)
+		// 44 bytes of WAV header plus 16-bit samples.
+		require.Equal(t, 44+16000*2, len(data))
+		require.Equal(t, "RIFF", string(data[:4]))
+
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, `{
+			"language": "english",
+			"text": "Hello there. General Kenobi.",
+			"segments": [
+				{"start": 0.0, "end": 1.25, "text": "Hello there."},
+				{"start": 1.25, "end": 2.5, "text": "General Kenobi."}
+			]
+		}`)
+	}))
+	defer srv.Close()
+
+	c := newTestClient(t, srv.URL+"/v1")
+
+	segments, lang, err := c.Transcribe(make([]float32, 16000))
+	require.NoError(t, err)
+	require.Equal(t, int32(1), reqs.Load())
+	// The language is normalized to the ISO 639-1 code the local path returns.
+	require.Equal(t, "en", lang)
+	require.Equal(t, []transcribe.Segment{
+		{Text: "Hello there.", StartTS: 0, EndTS: 1250},
+		{Text: "General Kenobi.", StartTS: 1250, EndTS: 2500},
+	}, segments)
+
+	require.NoError(t, c.Destroy())
+}
+
+func TestTranscribeEmptySamples(t *testing.T) {
+	c := newTestClient(t, "http://localhost:1")
+	_, _, err := c.Transcribe(nil)
+	require.EqualError(t, err, "samples should not be empty")
+}
+
+func TestTranscribeAuthFailure(t *testing.T) {
+	var reqs atomic.Int32
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		reqs.Add(1)
+		w.WriteHeader(http.StatusUnauthorized)
+		fmt.Fprint(w, `{"error": {"message": "Incorrect API key provided."}}`)
+	}))
+	defer srv.Close()
+
+	c := newTestClient(t, srv.URL+"/v1")
+
+	_, _, err := c.Transcribe(make([]float32, 16000))
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "401 Unauthorized")
+	require.Contains(t, err.Error(), "Incorrect API key provided.")
+	// Authentication failures should not be retried.
+	require.Equal(t, int32(1), reqs.Load())
+}
+
+func TestTranscribeRetriesTransientFailure(t *testing.T) {
+	var reqs atomic.Int32
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		if reqs.Add(1) == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		fmt.Fprint(w, `{"language": "en", "segments": [{"start": 0, "end": 1, "text": "ok"}]}`)
+	}))
+	defer srv.Close()
+
+	c := newTestClient(t, srv.URL+"/v1")
+
+	segments, lang, err := c.Transcribe(make([]float32, 16000))
+	require.NoError(t, err)
+	require.Equal(t, int32(2), reqs.Load())
+	require.Equal(t, "en", lang)
+	require.Equal(t, []transcribe.Segment{{Text: "ok", StartTS: 0, EndTS: 1000}}, segments)
+}
+
+func TestTranscribeTimeout(t *testing.T) {
+	var reqs atomic.Int32
+
+	blockCh := make(chan struct{})
+	srv := httptest.NewServer(http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) {
+		reqs.Add(1)
+		select {
+		case <-blockCh:
+		case <-r.Context().Done():
+		}
+	}))
+	defer srv.Close()
+	defer close(blockCh)
+
+	c := newTestClient(t, srv.URL+"/v1")
+	c.cfg.Timeout = 100 * time.Millisecond
+
+	_, _, err := c.Transcribe(make([]float32, 16000))
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "context deadline exceeded")
+	// Timeouts are transient so all the attempts should have been made.
+	require.Equal(t, int32(maxAttempts), reqs.Load())
+}
+
+func TestTranscribeChunking(t *testing.T) {
+	var reqs atomic.Int32
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		reqs.Add(1)
+		// Each chunk reports a segment covering its first second.
+		fmt.Fprint(w, `{"language": "english", "segments": [{"start": 0, "end": 1, "text": "chunk"}]}`)
+	}))
+	defer srv.Close()
+
+	c := newTestClient(t, srv.URL+"/v1")
+	// Two seconds worth of 16-bit samples per chunk.
+	c.maxUploadBytes = 16000 * 2 * 2
+
+	segments, lang, err := c.Transcribe(make([]float32, 16000*5))
+	require.NoError(t, err)
+	require.Equal(t, int32(3), reqs.Load())
+	require.Equal(t, "en", lang)
+	// Timestamps of the later chunks are offset by the chunk start.
+	require.Equal(t, []transcribe.Segment{
+		{Text: "chunk", StartTS: 0, EndTS: 1000},
+		{Text: "chunk", StartTS: 2000, EndTS: 3000},
+		{Text: "chunk", StartTS: 4000, EndTS: 5000},
+	}, segments)
+}
+
+func TestTranscribeNoSegmentsFallback(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		fmt.Fprint(w, `{"text": " just text "}`)
+	}))
+	defer srv.Close()
+
+	c := newTestClient(t, srv.URL+"/v1")
+
+	segments, lang, err := c.Transcribe(make([]float32, 16000*2))
+	require.NoError(t, err)
+	require.Empty(t, lang)
+	require.Equal(t, []transcribe.Segment{{Text: "just text", StartTS: 0, EndTS: 2000}}, segments)
+}
