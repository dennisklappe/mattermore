@@ -0,0 +1,362 @@
+// Package openai implements a transcription backend for any service exposing an
+// OpenAI compatible /v1/audio/transcriptions endpoint (e.g. OpenAI, Groq,
+// LocalAI, a self-hosted whisper server).
+//
+// NOTE: using this backend means sending call audio to a third party service.
+package openai
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log/slog"
+	"mime/multipart"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/mattermost/calls-transcriber/cmd/transcriber/transcribe"
+)
+
+const (
+	audioSampleRate = 16000
+	audioBitDepth   = 16
+	audioChannels   = 1
+
+	// defaults
+	BaseURLDefault = "https://api.openai.com/v1"
+	ModelDefault   = "whisper-1"
+	TimeoutDefault = 60 * time.Second
+
+	transcriptionsPath = "/audio/transcriptions"
+
+	// OpenAI rejects uploads bigger than 25MB. We keep some margin for the WAV
+	// header and the multipart envelope and split anything longer in chunks.
+	maxUploadBytesDefault = 24 * 1024 * 1024
+
+	// Transient failures (e.g. rate limiting, network errors) are retried.
+	// Authentication and other client errors are not.
+	maxAttempts     = 3
+	retryBackoff    = 500 * time.Millisecond
+	maxErrBodyBytes = 1024
+)
+
+// The local whisper.cpp path returns ISO 639-1 codes while some OpenAI
+// compatible services (OpenAI itself included) return the full English name of
+// the detected language. We map back the most common ones and pass through
+// anything else.
+var langCodes = map[string]string{
+	"arabic": "ar", "bulgarian": "bg", "catalan": "ca", "chinese": "zh", "czech": "cs",
+	"danish": "da", "dutch": "nl", "english": "en", "finnish": "fi", "french": "fr",
+	"german": "de", "greek": "el", "hebrew": "he", "hindi": "hi", "hungarian": "hu",
+	"indonesian": "id", "italian": "it", "japanese": "ja", "korean": "ko", "norwegian": "no",
+	"persian": "fa", "polish": "pl", "portuguese": "pt", "romanian": "ro", "russian": "ru",
+	"slovak": "sk", "spanish": "es", "swedish": "sv", "thai": "th", "turkish": "tr",
+	"ukrainian": "uk", "vietnamese": "vi",
+}
+
+type Config struct {
+	// The base URL of the OpenAI compatible API (e.g. https://api.openai.com/v1).
+	BaseURL string
+	// The API key used to authenticate. Can be empty for self-hosted services
+	// that don't require authentication.
+	APIKey string
+	// The transcription model to use (e.g. whisper-1).
+	Model string
+	// The timeout for a single transcription request.
+	Timeout time.Duration
+}
+
+func (c Config) IsValid() error {
+	if c.BaseURL == "" {
+		return fmt.Errorf("invalid BaseURL: should not be empty")
+	}
+
+	u, err := url.Parse(c.BaseURL)
+	if err != nil {
+		return fmt.Errorf("invalid BaseURL: parsing failed: %w", err)
+	} else if u.Scheme != "http" && u.Scheme != "https" {
+		return fmt.Errorf("invalid BaseURL: invalid scheme %q", u.Scheme)
+	}
+
+	if c.Model == "" {
+		return fmt.Errorf("invalid Model: should not be empty")
+	}
+
+	if c.Timeout <= 0 {
+		return fmt.Errorf("invalid Timeout: should be a positive duration")
+	}
+
+	return nil
+}
+
+func (c *Config) SetDefaults() {
+	if c.BaseURL == "" {
+		c.BaseURL = BaseURLDefault
+	}
+
+	if c.Model == "" {
+		c.Model = ModelDefault
+	}
+
+	if c.Timeout == 0 {
+		c.Timeout = TimeoutDefault
+	}
+}
+
+// LogValue implements slog.LogValuer so that the API key is never logged.
+func (c Config) LogValue() slog.Value {
+	var apiKey string
+	if c.APIKey != "" {
+		apiKey = "<redacted>"
+	}
+
+	return slog.GroupValue(
+		slog.String("BaseURL", c.BaseURL),
+		slog.String("APIKey", apiKey),
+		slog.String("Model", c.Model),
+		slog.Duration("Timeout", c.Timeout),
+	)
+}
+
+// permanentError marks an error that won't succeed if retried.
+type permanentError struct {
+	err error
+}
+
+func (e permanentError) Error() string { return e.err.Error() }
+func (e permanentError) Unwrap() error { return e.err }
+
+type Client struct {
+	cfg Config
+	url string
+
+	httpClient *http.Client
+
+	// The maximum size of a single upload. Longer audio is split in chunks.
+	maxUploadBytes int
+}
+
+func NewClient(cfg Config) (*Client, error) {
+	cfg.SetDefaults()
+
+	if err := cfg.IsValid(); err != nil {
+		return nil, fmt.Errorf("failed to validate config: %w", err)
+	}
+
+	slog.Debug("creating transcription client", slog.Any("cfg", cfg))
+
+	return &Client{
+		cfg: cfg,
+		url: strings.TrimSuffix(cfg.BaseURL, "/") + transcriptionsPath,
+		// The timeout is enforced per request through the request's context.
+		httpClient:     &http.Client{},
+		maxUploadBytes: maxUploadBytesDefault,
+	}, nil
+}
+
+func (c *Client) Transcribe(samples []float32) ([]transcribe.Segment, string, error) {
+	if len(samples) == 0 {
+		return nil, "", fmt.Errorf("samples should not be empty")
+	}
+
+	chunkLen := c.maxUploadBytes / (audioBitDepth / 8)
+	if len(samples) > chunkLen {
+		// Splitting is done on a fixed size boundary so it may well cut through
+		// a word. There's not much we can do about it since the API enforces a
+		// maximum upload size.
+		slog.Warn("audio exceeds the maximum upload size, splitting in chunks",
+			slog.Int("samplesLen", len(samples)),
+			slog.Int("chunkLen", chunkLen))
+	}
+
+	var lang string
+	var segments []transcribe.Segment
+	for off := 0; off < len(samples); off += chunkLen {
+		chunk := samples[off:min(off+chunkLen, len(samples))]
+
+		chunkSegments, chunkLang, err := c.transcribeChunk(chunk)
+		if err != nil {
+			return nil, "", fmt.Errorf("failed to transcribe chunk: %w", err)
+		}
+
+		if lang == "" {
+			lang = chunkLang
+		}
+
+		// The returned timestamps are relative to the beginning of the chunk so
+		// we offset them to make them relative to the whole input.
+		offsetMs := int64(off / (audioSampleRate / 1000))
+		for _, s := range chunkSegments {
+			s.StartTS += offsetMs
+			s.EndTS += offsetMs
+			segments = append(segments, s)
+		}
+	}
+
+	return segments, lang, nil
+}
+
+func (c *Client) Destroy() error {
+	c.httpClient.CloseIdleConnections()
+	return nil
+}
+
+type transcriptionResponse struct {
+	Language string `json:"language"`
+	Text     string `json:"text"`
+	Segments []struct {
+		Start float64 `json:"start"`
+		End   float64 `json:"end"`
+		Text  string  `json:"text"`
+	} `json:"segments"`
+}
+
+func (c *Client) transcribeChunk(samples []float32) ([]transcribe.Segment, string, error) {
+	body, contentType, err := c.newRequestBody(samples)
+	if err != nil {
+		return nil, "", err
+	}
+
+	durMs := int64(len(samples) / (audioSampleRate / 1000))
+
+	for attempt := 1; ; attempt++ {
+		res, err := c.doRequest(body, contentType)
+		if err == nil {
+			return segmentsFromResponse(res, durMs)
+		}
+
+		var permErr permanentError
+		if errors.As(err, &permErr) || attempt == maxAttempts {
+			return nil, "", err
+		}
+
+		slog.Warn("transcription request failed, retrying",
+			slog.String("err", err.Error()),
+			slog.Int("attempt", attempt))
+
+		time.Sleep(time.Duration(attempt) * retryBackoff)
+	}
+}
+
+func (c *Client) newRequestBody(samples []float32) ([]byte, string, error) {
+	var buf bytes.Buffer
+	mw := multipart.NewWriter(&buf)
+
+	fw, err := mw.CreateFormFile("file", "audio.wav")
+	if err != nil {
+		return nil, "", fmt.Errorf("failed to create form file: %w", err)
+	}
+
+	if _, err := fw.Write(f32PCMToWAV(samples)); err != nil {
+		return nil, "", fmt.Errorf("failed to write audio data: %w", err)
+	}
+
+	if err := mw.WriteField("model", c.cfg.Model); err != nil {
+		return nil, "", fmt.Errorf("failed to write model field: %w", err)
+	}
+
+	// Needed to get segments, timestamps and the detected language back.
+	if err := mw.WriteField("response_format", "verbose_json"); err != nil {
+		return nil, "", fmt.Errorf("failed to write response_format field: %w", err)
+	}
+
+	if err := mw.Close(); err != nil {
+		return nil, "", fmt.Errorf("failed to close multipart writer: %w", err)
+	}
+
+	return buf.Bytes(), mw.FormDataContentType(), nil
+}
+
+func (c *Client) doRequest(body []byte, contentType string) (*transcriptionResponse, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), c.cfg.Timeout)
+	defer cancel()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.url, bytes.NewReader(body))
+	if err != nil {
+		return nil, permanentError{fmt.Errorf("failed to create request: %w", err)}
+	}
+	req.Header.Set("Content-Type", contentType)
+	if c.cfg.APIKey != "" {
+		req.Header.Set("Authorization", "Bearer "+c.cfg.APIKey)
+	}
+
+	res, err := c.httpClient.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("failed to send request: %w", err)
+	}
+	defer res.Body.Close()
+
+	if res.StatusCode != http.StatusOK {
+		// The error body is read back to help debugging but it's bounded as we
+		// have no control over its size.
+		data, _ := io.ReadAll(io.LimitReader(res.Body, maxErrBodyBytes))
+		err := fmt.Errorf("request failed with status %q: %s", res.Status, strings.TrimSpace(string(data)))
+		if !isRetryableStatus(res.StatusCode) {
+			return nil, permanentError{err}
+		}
+		return nil, err
+	}
+
+	var tr transcriptionResponse
+	if err := json.NewDecoder(res.Body).Decode(&tr); err != nil {
+		return nil, permanentError{fmt.Errorf("failed to decode response body: %w", err)}
+	}
+
+	return &tr, nil
+}
+
+// isRetryableStatus reports whether a request that failed with the given status
+// code is worth retrying. Authentication, authorization and malformed request
+// failures are permanent.
+func isRetryableStatus(code int) bool {
+	return code == http.StatusRequestTimeout ||
+		code == http.StatusTooManyRequests ||
+		code >= http.StatusInternalServerError
+}
+
+func segmentsFromResponse(res *transcriptionResponse, durMs int64) ([]transcribe.Segment, string, error) {
+	lang := normalizeLanguage(res.Language)
+
+	if len(res.Segments) == 0 {
+		text := strings.TrimSpace(res.Text)
+		if text == "" {
+			return nil, lang, nil
+		}
+
+		// Some OpenAI compatible services ignore the verbose_json response
+		// format and only return the full text. The best we can do in that case
+		// is a single segment spanning the whole input.
+		slog.Warn("no segments in response, falling back to a single segment")
+
+		return []transcribe.Segment{{
+			Text:    text,
+			StartTS: 0,
+			EndTS:   durMs,
+		}}, lang, nil
+	}
+
+	segments := make([]transcribe.Segment, 0, len(res.Segments))
+	for _, s := range res.Segments {
+		segments = append(segments, transcribe.Segment{
+			Text: s.Text,
+			// Timestamps are returned in seconds, ours are in milliseconds.
+			StartTS: int64(s.Start * 1000),
+			EndTS:   int64(s.End * 1000),
+		})
+	}
+
+	return segments, lang, nil
+}
+
+func normalizeLanguage(lang string) string {
+	lang = strings.ToLower(strings.TrimSpace(lang))
+	if code, ok := langCodes[lang]; ok {
+		return code
+	}
+	return lang
+}
